---
/** The changelog in one language; `pages/changelog.astro` and `pages/[locale]/changelog.astro` render it. */
import SiteLayout from '@/app/layouts/SiteLayout.astro';
import { strings } from '@/core/i18n';
import type { Locale } from '@/core/site';
import { ChangelogHero, Timeline } from '@/features/changelog';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = strings(locale);
---

<SiteLayout title={s['changelog.title']} description={s['changelog.description']} locale={locale}>
  <ChangelogHero locale={locale} />
  <div class="container">
    <Timeline locale={locale} />
  </div>
</SiteLayout>
