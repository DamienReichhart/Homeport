---
import lockupDark from '@brand/lockup-dark.svg';
import lockupLight from '@brand/lockup-light.svg';
import { strings } from '@/core/i18n';
import { type Locale, localePath, REPO_URL } from '@/core/site';
import { href } from '@/shared/lib/href';
import { Icon } from '@/shared/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  /** Where the language menu goes from: the page's path without the base, or `/` for an English-only page. */
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const s = strings(locale);
const url = (path: string) => href(localePath(path, locale));

const links = [
  { label: s['header.features'], path: '/#features' },
  { label: s['header.docs'], path: '/docs/' },
  { label: s['header.changelog'], path: '/changelog/' },
];
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href={url('/')} aria-label={s['header.home']}>
      <img
        class="only-light"
        src={lockupLight.src}
        alt={s['header.logo']}
        width="150"
        height="22"
      />
      <img class="only-dark" src={lockupDark.src} alt={s['header.logo']} width="150" height="22" />
    </a>

    <nav class="site-header__nav" aria-label={s['header.nav']}>
      {links.map((link) => (
        <a href={url(link.path)} aria-current={current === url(link.path) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="site-header__actions">
      <a class="icon-button" href={REPO_URL} aria-label={s['header.github']}>
        <Icon name="github" />
      </a>
      <LanguageSwitcher currentPath={currentPath} />
      <ThemeToggle />
      <a class="button button--primary button--small" href={url('/download/')}>
        {s['header.download']}
      </a>

      <details class="site-header__menu">
        <summary class="icon-button" aria-label={s['header.menu']}>
          <Icon name="menu" />
        </summary>
        <div class="site-header__sheet">
          {links.map((link) => (
            <a href={url(link.path)}>{link.label}</a>
          ))}
          <a href={url('/download/')}>{s['header.download']}</a>
          <a href={REPO_URL}>{s['header.githubShort']}</a>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Close the mobile menu after following an in-page link.
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('.site-header__menu')) {
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) menu.open = false;
    });
  }
</script>
