---
import mark from '@brand/mark.svg';
import { type StringKey, strings } from '@/core/i18n';
import {
  ISSUES_URL,
  type Locale,
  localePath,
  RELEASES_URL,
  REPO_URL,
  ROOT_LOCALE,
} from '@/core/site';
import { LEGAL_DOCUMENTS } from '@/features/legal';
import { href } from '@/shared/lib/href';
import { escapeHtml, fillHtml } from '@/shared/lib/template';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = strings(locale);
const url = (path: string) => href(localePath(path, locale));
const year = new Date().getFullYear();

const columns = [
  {
    title: s['footer.product'],
    links: [
      { label: s['footer.features'], url: url('/#features') },
      { label: s['footer.download'], url: url('/download/') },
      { label: s['footer.changelog'], url: url('/changelog/') },
      { label: s['footer.releases'], url: RELEASES_URL },
    ],
  },
  {
    title: s['footer.documentation'],
    links: [
      { label: s['footer.introduction'], url: url('/docs/') },
      { label: s['footer.installation'], url: url('/docs/installation/') },
      { label: s['footer.hosts'], url: url('/docs/hosts/') },
      { label: s['footer.troubleshooting'], url: url('/docs/reference/troubleshooting/') },
    ],
  },
  {
    title: s['footer.project'],
    links: [
      { label: s['footer.source'], url: REPO_URL },
      { label: s['footer.issue'], url: ISSUES_URL },
      { label: s['footer.contributing'], url: url('/docs/project/contributing/') },
      { label: s['footer.security'], url: url('/docs/reference/security/') },
    ],
  },
];

/** The legal documents are in English only, so their links don't change with the page's language. */
const legalLabels: Record<(typeof LEGAL_DOCUMENTS)[number]['path'], StringKey> = {
  '/legal-notice/': 'footer.legalNotice',
  '/privacy/': 'footer.privacy',
  '/terms/': 'footer.terms',
  '/cookies/': 'footer.cookies',
};
const legalLang = locale === ROOT_LOCALE ? undefined : ROOT_LOCALE.lang;
const licence = fillHtml(s['footer.licence'], {
  year: String(year),
  licence: `<a href="${REPO_URL}/blob/main/LICENSE">${escapeHtml(s['footer.licenceName'])}</a>`,
});
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <img src={mark.src} alt="" width="36" height="36" />
      <p>
        <strong>Homeport</strong>
        <br />
        {s['site.tagline']}
      </p>
    </div>
    {columns.map((column) => (
      <div class="site-footer__column">
        <h2>{column.title}</h2>
        <ul>
          {column.links.map((link) => (
            <li>
              <a href={link.url}>{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="site-footer__legal">
    <nav class="site-footer__legal-links" aria-label={s['footer.legal']}>
      {LEGAL_DOCUMENTS.map((document) => (
        <a href={href(document.path)} hreflang={legalLang}>
          {s[legalLabels[document.path]]}
        </a>
      ))}
    </nav>
    <p set:html={licence} />
    <p>{s['footer.trademark']}</p>
  </div>
</footer>
