---
/*
 * Layout for the marketing pages (home, download, changelog). The docs use
 * Starlight's own layout; both share the palette in app/styles/theme.css and the
 * theme the visitor picked (localStorage `starlight-theme`).
 */
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@/app/styles/theme.css';
import '@/app/styles/site/index.css';
import SiteFooter from '@/app/chrome/SiteFooter.astro';
import SiteHeader from '@/app/chrome/SiteHeader.astro';
import { DESCRIPTION, REPO_URL } from '@/core/site';

interface Props {
  title: string;
  description?: string;
  /** Structured data (JSON-LD) for search engines. */
  jsonLd?: Record<string, unknown>;
}

const { title, description = DESCRIPTION, jsonLd } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}/og.png`, Astro.site);
---

<!doctype html>
<html lang="en-GB" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b121b" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Homeport" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Homeport — Every Docker Engine, docked in one place." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="me" href={REPO_URL} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    {/* Apply the stored or system theme before first paint, the same way Starlight does. */}
    <script is:inline>
      (() => {
        let stored = '';
        try {
          stored = localStorage.getItem('starlight-theme') || '';
        } catch {
          // Storage can be unavailable (private mode): follow the system.
        }
        const light = matchMedia('(prefers-color-scheme: light)').matches;
        document.documentElement.dataset.theme = stored || (light ? 'light' : 'dark');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
