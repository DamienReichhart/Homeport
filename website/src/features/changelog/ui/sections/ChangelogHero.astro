---
/** The changelog's title, and a note that the release notes stay in English. */
import { strings } from '@/core/i18n';
import { type Locale, localePath, ROOT_LOCALE } from '@/core/site';
import { href } from '@/shared/lib/href';
import { escapeHtml, fillHtml } from '@/shared/lib/template';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = strings(locale);
const downloadPage = `<a href="${href(localePath('/download/', locale))}">${escapeHtml(s['changelog.downloadPage'])}</a>`;
---

<section class="changelog-hero">
  <div class="container">
    <span class="eyebrow">{s['changelog.eyebrow']}</span>
    <h1>{s['changelog.heading']}</h1>
    <p set:html={fillHtml(s['changelog.lead'], { link: downloadPage })} />
    {locale !== ROOT_LOCALE && <p class="changelog-hero__note">{s['changelog.notesInEnglish']}</p>}
  </div>
</section>

<style>
  .changelog-hero {
    padding: 4.5rem 0 3rem;
  }
  .changelog-hero .container {
    display: grid;
    gap: 0.85rem;
    max-width: 52rem;
  }
  .changelog-hero h1 {
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.5rem);
  }
  .changelog-hero p {
    color: var(--hp-text-muted);
    font-size: 1.1rem;
  }
  .changelog-hero .changelog-hero__note {
    color: var(--hp-text-faint);
    font-size: 0.9rem;
  }
</style>
