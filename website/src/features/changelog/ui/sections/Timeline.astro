---
/** Every release, newest first, or a link to GitHub when the releases couldn't be read. */
import { strings } from '@/core/i18n';
import { getReleases } from '@/core/release';
import { type Locale, RELEASES_URL, ROOT_LOCALE } from '@/core/site';
import { escapeHtml, fillHtml } from '@/shared/lib/template';
import ReleaseEntry from '../ReleaseEntry.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = strings(locale);
const releases = await getReleases();
const github = `<a href="${RELEASES_URL}">${escapeHtml(s['changelog.github'])}</a>`;
---

{releases.length === 0 ? (
  <p class="empty" set:html={fillHtml(s['changelog.empty'], { link: github })} />
) : (
  <ol class="timeline" lang={locale === ROOT_LOCALE ? undefined : 'en'}>
    {releases.map((release, index) => (
      <ReleaseEntry release={release} latest={index === 0} locale={locale} />
    ))}
  </ol>
)}

<style>
  .empty {
    color: var(--hp-text-muted);
  }

  .timeline {
    max-width: 52rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
</style>
