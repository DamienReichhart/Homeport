---
/**
 * The line map for narrow screens: this machine, then each line as a coloured
 * rail with its stations under it. LineMap.astro shows it under 64rem.
 */
import { strings } from '@/core/i18n';
import type { Locale } from '@/core/site';
import { KEY_ORDER, lineById, lineName } from '../model/fleet';

interface Props {
  locale: Locale;
}

const s = strings(Astro.props.locale);
---

<ol class="line-map__strips" aria-label={s['home.map.label']}>
  <li class="line-map__home">
    <span class="line-map__home-mark" aria-hidden="true"></span>
    {s['home.map.thisMachine']}
  </li>
  {KEY_ORDER.map((id) => {
    const line = lineById(id);
    return (
      <li class="strip" style={`--line: var(${line.colour})`}>
        <span class="strip__name">{lineName(id, s)}</span>
        <ol>
          {line.stations.map((station) => (
            <li class:list={[station.signal && 'is-signal']}>
              <span
                class:list={['station', station.signal && 'station--signal']}
                aria-hidden="true"
              />
              <span class="strip__host">{station.host}</span>
              <span class="strip__engine">{station.engine}</span>
              {station.signal && <span class="strip__signal">{s['home.map.needsYou']}</span>}
            </li>
          ))}
        </ol>
      </li>
    );
  })}
</ol>

<style>
  /*
   * Under 64rem the map is drawn top to bottom: this machine at the top, an ink
   * trunk down the start edge, and each line branching off it in its own colour
   * to a rail with its stations.
   */
  .line-map__strips {
    position: relative;
    display: grid;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    padding-inline-start: 2.5rem;
    list-style: none;
  }
  /* The trunk, from the terminus down; the last strip hides what runs past its branch. */
  .line-map__strips::before {
    content: '';
    position: absolute;
    inset-inline-start: 0.6rem;
    top: 0.8rem;
    bottom: 0;
    width: 6px;
    background: var(--hp-line-socket);
  }
  .strip:last-child::before {
    content: '';
    position: absolute;
    inset-inline-start: calc(-2.5rem + 0.6rem - 1px);
    top: calc(0.75rem + 3px);
    bottom: -1px;
    width: 8px;
    background: var(--hp-bg);
  }
  .line-map__home {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-inline-start: -2.5rem;
    font-weight: 600;
  }
  .line-map__home-mark {
    width: 2.25rem;
    height: 1.1rem;
    border-radius: 2px;
    background: var(--hp-line-socket);
  }
  .strip {
    position: relative;
    display: grid;
    gap: 0.6rem;
  }
  /* The branch: from the trunk to the line's own rail, at the line's name. */
  .strip::after {
    content: '';
    position: absolute;
    inset-inline-start: calc(-2.5rem + 0.6rem);
    top: calc(0.75rem - 3px);
    width: calc(2.5rem - 0.6rem + 0.475rem + 3px);
    height: 6px;
    background: var(--line);
  }
  .strip__name {
    padding-inline-start: 2rem;
    color: var(--hp-text-muted);
    font-size: 0.95rem;
    line-height: 1.5rem;
  }
  .strip ol {
    position: relative;
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    padding-inline-start: 2rem;
    list-style: none;
  }
  /* The rail runs from the branch through the centre of every station. */
  .strip ol::before {
    content: '';
    position: absolute;
    inset-inline-start: calc(0.475rem - 3px);
    top: -1.35rem;
    bottom: 0.4rem;
    width: 6px;
    background: var(--line);
  }
  .strip li {
    position: relative;
    display: grid;
    line-height: 1.35;
  }
  .strip .station {
    position: absolute;
    inset-inline-start: -2rem;
    top: 0.2rem;
  }
  .strip__host {
    font-weight: 600;
  }
  .strip__engine {
    color: var(--hp-text-muted);
    font-size: 0.95rem;
  }
  .strip__signal {
    color: var(--hp-signal);
    font-size: 0.95rem;
    font-weight: 600;
  }
  @media (min-width: 64rem) {
    .line-map__strips {
      display: none;
    }
  }
</style>
