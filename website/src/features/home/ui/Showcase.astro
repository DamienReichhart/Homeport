---
/*
 * A section in two columns: an eyebrow, a title and the default slot beside the
 * `media` slot (a screenshot). `reverse` puts the media first on wide screens.
 */
interface Props {
  eyebrow: string;
  title: string;
  reverse?: boolean;
  raised?: boolean;
}

const { eyebrow, title, reverse = false, raised = false } = Astro.props;
---

<section class:list={['section', raised && 'section--raised']}>
  <div class:list={['container split', reverse && 'split--reverse']}>
    <div class="split__text" data-reveal>
      <span class="eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
      <slot />
    </div>
    <div class="split__media" data-reveal>
      <slot name="media" />
    </div>
  </div>
</section>

<style>
  .split {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 64rem) {
    .split {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: 3.5rem;
    }
    .split--reverse {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    }
    .split--reverse .split__text {
      order: 2;
    }
  }
  .split__text {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .split__text h2 {
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
  }
  .split__text > :global(p) {
    color: var(--hp-text-muted);
    font-size: 1.075rem;
  }
</style>
