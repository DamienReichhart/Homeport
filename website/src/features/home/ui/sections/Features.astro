---
/** What Homeport does, a card per area. */
import { strings } from '@/core/i18n';
import type { Locale } from '@/core/site';
import { Icon } from '@/shared/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = strings(locale);

const features = (
  [
    ['hosts', 'server'],
    ['containers', 'box'],
    ['stacks', 'boxes'],
    ['swarm', 'network'],
    ['podman', 'fileText'],
    ['containerd', 'box'],
    ['incus', 'server'],
    ['clusters', 'shipWheel'],
    ['images', 'layers'],
    ['volumes', 'hardDrive'],
    ['board', 'activity'],
    ['keyboard', 'zap'],
    ['background', 'gauge'],
  ] as const
).map(([id, icon]) => ({
  icon,
  title: s[`home.features.${id}.title`],
  body: s[`home.features.${id}.body`],
}));
---

<section class="section" id="features">
  <div class="container">
    <div class="section-heading section-heading--center" data-reveal>
      <span class="eyebrow">{s['home.features.eyebrow']}</span>
      <h2>{s['home.features.title']}</h2>
      <p>{s['home.features.lead']}</p>
    </div>
    <div class="feature-grid">
      {features.map((feature) => (
        <article class="card feature" data-reveal>
          <span class="feature-icon">
            <Icon name={feature.icon} />
          </span>
          <h3>{feature.title}</h3>
          <p>{feature.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .feature-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .feature {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1.75rem;
    transition: border-color 0.2s ease;
  }
  .feature:hover {
    border-color: var(--hp-border-strong);
  }
  .feature h3 {
    margin-top: 0.5rem;
    font-size: 1.15rem;
  }
  .feature p {
    color: var(--hp-text-muted);
  }
</style>
