---
/** Managed, linked, synced and found Compose Stacks. */
import { strings } from '@/core/i18n';
import { type Locale, localePath } from '@/core/site';
import { href } from '@/shared/lib/href';
import { Screenshot, TextLink } from '@/shared/ui';
import { SHOWCASE_SIZES } from '../../model/showcase';
import Showcase from '../Showcase.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = strings(locale);
---

<Showcase eyebrow={s['home.stacks.eyebrow']} title={s['home.stacks.title']} raised>
  <p>{s['home.stacks.body']}</p>
  <TextLink href={href(localePath('/docs/guides/stacks/', locale))}>
    {s['home.stacks.link']}
  </TextLink>
  <Screenshot
    slot="media"
    name="stack-editor"
    folder={locale.code}
    alt={s['home.stacks.screenshot']}
    sizes={SHOWCASE_SIZES}
  />
</Showcase>
