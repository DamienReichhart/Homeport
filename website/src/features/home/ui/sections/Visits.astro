---
/**
 * The position: Homeport stays on your machine and visits your servers. It
 * says plainly what that costs on the server, port by port.
 */
import { href } from '@/shared/lib/href';
import { TextLink } from '@/shared/ui';

const absences = [
  {
    title: 'No agent',
    body: 'Nothing to install, update or secure on the server. Homeport talks to the Engine that is already there.',
  },
  {
    title: 'No web panel',
    body: 'No dashboard deployed on your servers, and no login page waiting for someone to find it.',
  },
  {
    title: 'No account',
    body: 'No sign-in, no seat, no subscription and no telemetry. It shows you your containers, and that is all.',
  },
];
---

<section class="section section--raised" id="visits">
  <div class="container visits">
    <div class="visits__statement" data-reveal>
      <span class="eyebrow">Where it lives</span>
      <h2>Homeport stays on your machine and visits your servers. It never moves in.</h2>
    </div>

    <ul class="visits__list" data-reveal>
      {absences.map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))}
    </ul>

    <div class="visits__ports" data-reveal>
      <h3>What it needs on the server, honestly</h3>
      <dl>
        <div>
          <dt>SSH</dt>
          <dd>
            The port you already have open. With the key Homeport makes, one line in{' '}
            <code>authorized_keys</code>.
          </dd>
        </div>
        <div>
          <dt>TLS</dt>
          <dd>
            The Engine’s own API port (usually <code>2376</code>), which you expose yourself.
          </dd>
        </div>
        <div>
          <dt>TCP</dt>
          <dd>
            The Engine’s API port (usually <code>2375</code>), unencrypted. Only on a network you
            trust.
          </dd>
        </div>
      </dl>
      <p>When you can, use SSH: it adds nothing to the server you’re not already running.</p>
      <TextLink href={href('/docs/hosts/')}>How connections work</TextLink>
    </div>
  </div>
</section>

<style>
  .visits {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 64rem) {
    .visits {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: 4rem;
    }
    .visits__statement {
      grid-column: 1 / -1;
    }
  }
  .visits__statement {
    display: grid;
    gap: 1.25rem;
  }
  .visits__statement h2 {
    max-width: 22ch;
    font-size: clamp(1.9rem, 1.2rem + 2.6vw, 3.25rem);
    letter-spacing: -0.03em;
  }
  .visits__list {
    display: grid;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hp-text);
    list-style: none;
  }
  .visits__list li {
    display: grid;
    gap: 0.35rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--hp-border-strong);
  }
  @media (min-width: 40rem) {
    .visits__list li {
      grid-template-columns: 10rem 1fr;
      gap: 1.5rem;
    }
  }
  .visits__list h3 {
    font-size: 1.15rem;
  }
  .visits__list p {
    color: var(--hp-text-muted);
  }
  .visits__ports {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--hp-border-strong);
    border-radius: var(--hp-radius-lg);
    background: var(--hp-surface);
  }
  .visits__ports h3 {
    font-size: 1rem;
  }
  .visits__ports dl {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }
  .visits__ports dl div {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 0.75rem;
  }
  .visits__ports dt {
    font-family: var(--sl-font-mono);
    font-size: 0.85rem;
    padding-top: 0.1rem;
  }
  .visits__ports dd {
    margin: 0;
    color: var(--hp-text-muted);
    font-size: 0.95rem;
  }
  .visits__ports > p {
    color: var(--hp-text-muted);
    font-size: 0.95rem;
  }
</style>
