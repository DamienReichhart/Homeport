---
/**
 * The position: Homeport stays on your machine and visits your servers. It
 * says plainly what that costs on the server, port by port.
 */
import { strings } from '@/core/i18n';
import { type Locale, localePath } from '@/core/site';
import { href } from '@/shared/lib/href';
import { fillHtml } from '@/shared/lib/template';
import { TextLink } from '@/shared/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = strings(locale);

const absences = (['agent', 'panel', 'account'] as const).map((id) => ({
  title: s[`home.visits.${id}.title`],
  body: s[`home.visits.${id}.body`],
}));
---

<section class="section section--raised" id="visits">
  <div class="container visits">
    <div class="visits__statement" data-reveal>
      <span class="eyebrow">{s['home.visits.eyebrow']}</span>
      <h2>{s['home.visits.title']}</h2>
    </div>

    <ul class="visits__list" data-reveal>
      {absences.map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))}
    </ul>

    <div class="visits__ports" data-reveal>
      <h3>{s['home.visits.ports.title']}</h3>
      <dl>
        <div>
          <dt>SSH</dt>
          <dd
            set:html={fillHtml(s['home.visits.ports.ssh'], {
              file: '<code>authorized_keys</code>',
            })}
          />
        </div>
        <div>
          <dt>TLS</dt>
          <dd set:html={fillHtml(s['home.visits.ports.tls'], { port: '<code>2376</code>' })} />
        </div>
        <div>
          <dt>TCP</dt>
          <dd set:html={fillHtml(s['home.visits.ports.tcp'], { port: '<code>2375</code>' })} />
        </div>
      </dl>
      <p>{s['home.visits.ports.advice']}</p>
      <TextLink href={href(localePath('/docs/hosts/', locale))}>{s['home.visits.link']}</TextLink>
    </div>
  </div>
</section>

<style>
  .visits {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 64rem) {
    .visits {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: 4rem;
    }
    .visits__statement {
      grid-column: 1 / -1;
    }
  }
  .visits__statement {
    display: grid;
    gap: 1.25rem;
  }
  .visits__statement h2 {
    max-width: 22ch;
    font-size: clamp(1.9rem, 1.2rem + 2.6vw, 3.25rem);
    letter-spacing: -0.03em;
  }
  .visits__list {
    display: grid;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hp-text);
    list-style: none;
  }
  .visits__list li {
    display: grid;
    gap: 0.35rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--hp-border-strong);
  }
  @media (min-width: 40rem) {
    .visits__list li {
      grid-template-columns: 10rem 1fr;
      gap: 1.5rem;
    }
  }
  .visits__list h3 {
    font-size: 1.15rem;
  }
  .visits__list p {
    color: var(--hp-text-muted);
  }
  .visits__ports {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--hp-border-strong);
    border-radius: var(--hp-radius-lg);
    background: var(--hp-surface);
  }
  .visits__ports h3 {
    font-size: 1rem;
  }
  .visits__ports dl {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }
  .visits__ports dl div {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 0.75rem;
  }
  .visits__ports dt {
    font-family: var(--sl-font-mono);
    font-size: 0.85rem;
    padding-top: 0.1rem;
  }
  .visits__ports dd {
    margin: 0;
    color: var(--hp-text-muted);
    font-size: 0.95rem;
  }
  .visits__ports > p {
    color: var(--hp-text-muted);
    font-size: 0.95rem;
  }
</style>
