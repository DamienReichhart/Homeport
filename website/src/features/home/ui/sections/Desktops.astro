---
/** A card per desktop platform, each linking to its downloads. */
import { strings } from '@/core/i18n';
import { type Locale, localePath } from '@/core/site';
import { href } from '@/shared/lib/href';
import { Icon } from '@/shared/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = strings(locale);

const platforms = [
  { os: 'windows', name: 'Windows', icon: 'windows' },
  { os: 'macos', name: 'macOS', icon: 'apple' },
  { os: 'linux', name: 'Linux', icon: 'linux' },
] as const;
---

<section class="section section--raised">
  <div class="container">
    <div class="section-heading section-heading--center" data-reveal>
      <span class="eyebrow">{s['home.desktops.eyebrow']}</span>
      <h2>{s['home.desktops.title']}</h2>
      <p>{s['home.desktops.lead']}</p>
    </div>
    <div class="platform-grid">
      {platforms.map((platform) => (
        <a
          class="card platform"
          href={href(localePath(`/download/#${platform.os}`, locale))}
          data-reveal
        >
          <Icon name={platform.icon} size={32} />
          <h3>{platform.name}</h3>
          <p>{s[`home.desktops.${platform.os}.versions`]}</p>
          <span>{s[`home.desktops.${platform.os}.formats`]}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .platform-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }
  .platform {
    display: grid;
    gap: 0.4rem;
    justify-items: center;
    padding: 2rem 1.5rem;
    color: var(--hp-text);
    text-align: center;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }
  .platform:hover {
    border-color: var(--hp-text);
    color: var(--hp-text);
  }
  .platform > :global(svg) {
    margin-bottom: 0.5rem;
  }
  .platform h3 {
    font-size: 1.25rem;
  }
  .platform p {
    color: var(--hp-text-muted);
  }
  .platform span {
    color: var(--hp-text-faint);
    font-size: 0.875rem;
  }
</style>
