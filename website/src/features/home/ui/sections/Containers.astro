---
/** A container's tools: logs, terminal, files and stats. */
import { strings } from '@/core/i18n';
import { type Locale, localePath } from '@/core/site';
import { href } from '@/shared/lib/href';
import { Icon, Screenshot, TextLink } from '@/shared/ui';
import { SHOWCASE_SIZES } from '../../model/showcase';
import Showcase from '../Showcase.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = strings(locale);

const containerTools = (
  [
    ['logs', 'fileText'],
    ['terminal', 'terminal'],
    ['files', 'folder'],
    ['stats', 'gauge'],
  ] as const
).map(([id, icon]) => ({
  icon,
  title: s[`home.containers.${id}.title`],
  body: s[`home.containers.${id}.body`],
}));
---

<Showcase eyebrow={s['home.containers.eyebrow']} title={s['home.containers.title']} reverse>
  <p>{s['home.containers.body']}</p>
  <ul class="tool-grid">
    {containerTools.map((tool) => (
      <li>
        <Icon name={tool.icon} />
        <div>
          <strong>{tool.title}</strong>
          <span>{tool.body}</span>
        </div>
      </li>
    ))}
  </ul>
  <TextLink href={href(localePath('/docs/guides/containers/', locale))}>
    {s['home.containers.link']}
  </TextLink>
  <Screenshot
    slot="media"
    name="container-logs"
    folder={locale.code}
    alt={s['home.containers.screenshot']}
    sizes={SHOWCASE_SIZES}
  />
</Showcase>

<style>
  .tool-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    margin: 0.5rem 0;
    padding: 0;
    list-style: none;
  }
  .tool-grid li {
    display: flex;
    gap: 0.75rem;
  }
  .tool-grid li > :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--hp-primary);
  }
  .tool-grid strong {
    display: block;
  }
  .tool-grid span {
    color: var(--hp-text-muted);
    font-size: 0.925rem;
  }
</style>
