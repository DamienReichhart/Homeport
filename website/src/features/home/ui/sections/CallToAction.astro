---
/** The closing call to download or contribute. */
import { REPO_URL } from '@/core/site';
import { DownloadButton } from '@/features/download';
import { Icon } from '@/shared/ui';
---

<section class="section">
  <div class="container">
    <div class="cta card" data-reveal>
      <div class="cta__text">
        <h2>Nothing to install on your servers.</h2>
        <p>
          Download Homeport on the machine you work from and add your Hosts. It’s free, open source
          under the MIT licence, and built in the open on GitHub.
        </p>
      </div>
      <div class="cta__actions">
        <DownloadButton />
        <a class="button button--secondary button--large" href={REPO_URL}>
          <Icon name="github" />
          View on GitHub
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta.card {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 2rem;
    align-items: center;
    padding: clamp(2rem, 1rem + 4vw, 4rem);
    border-top: 2px solid var(--hp-text);
    background: var(--hp-surface);
  }
  @media (min-width: 64rem) {
    .cta {
      grid-template-columns: 1fr auto;
    }
  }
  .cta__text {
    display: grid;
    gap: 0.75rem;
    max-width: 36rem;
  }
  .cta h2 {
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
  }
  .cta p {
    color: var(--hp-text-muted);
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
