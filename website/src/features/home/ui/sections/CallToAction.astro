---
/** The closing call to download or contribute. */
import { strings } from '@/core/i18n';
import { type Locale, REPO_URL } from '@/core/site';
import { DownloadButton } from '@/features/download';
import { Icon } from '@/shared/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = strings(locale);
---

<section class="section">
  <div class="container">
    <div class="cta card" data-reveal>
      <div class="cta__text">
        <h2>{s['home.cta.title']}</h2>
        <p>{s['home.cta.body']}</p>
      </div>
      <div class="cta__actions">
        <DownloadButton locale={locale} />
        <a class="button button--secondary button--large" href={REPO_URL}>
          <Icon name="github" />
          {s['home.cta.github']}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta.card {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 2rem;
    align-items: center;
    padding: clamp(2rem, 1rem + 4vw, 4rem);
    border-top: 2px solid var(--hp-text);
    background: var(--hp-surface);
  }
  @media (min-width: 64rem) {
    .cta {
      grid-template-columns: 1fr auto;
    }
  }
  .cta__text {
    display: grid;
    gap: 0.75rem;
    max-width: 36rem;
  }
  .cta h2 {
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
  }
  .cta p {
    color: var(--hp-text-muted);
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
