---
/** Connecting to remote Engines, and the ways Homeport reaches them. */
import { strings } from '@/core/i18n';
import { type Locale, localePath } from '@/core/site';
import { href } from '@/shared/lib/href';
import { fillHtml } from '@/shared/lib/template';
import { Screenshot, TextLink } from '@/shared/ui';
import { SHOWCASE_SIZES } from '../../model/showcase';
import Showcase from '../Showcase.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = strings(locale);

const connections = [
  {
    name: s['home.hosts.socket.name'],
    detail: s['home.hosts.socket.detail'],
    code: '/var/run/docker.sock',
  },
  { name: 'SSH', detail: s['home.hosts.ssh.detail'], code: 'deploy@server.example.com' },
  { name: 'TLS', detail: s['home.hosts.tls.detail'], code: 'docker.example.com:2376' },
  { name: 'TCP', detail: s['home.hosts.tcp.detail'], code: '192.168.1.10:2375' },
];
---

<Showcase eyebrow={s['home.hosts.eyebrow']} title={s['home.hosts.title']} raised>
  <p>{s['home.hosts.body']}</p>
  <p set:html={fillHtml(s['home.hosts.import'], { file: '<code>~/.ssh/config</code>' })} />
  <ul class="connection-list">
    {connections.map((c) => (
      <li>
        <strong>{c.name}</strong>
        <span>{c.detail}</span>
        <code>{c.code}</code>
      </li>
    ))}
  </ul>
  <TextLink href={href(localePath('/docs/hosts/', locale))}>{s['home.hosts.link']}</TextLink>
  <Screenshot
    slot="media"
    name="add-host-ssh"
    folder={locale.code}
    alt={s['home.hosts.screenshot']}
    crop="960 / 820"
    sizes={SHOWCASE_SIZES}
  />
</Showcase>

<style>
  .connection-list {
    display: grid;
    gap: 0.5rem;
    margin: 0.5rem 0;
    padding: 0;
    list-style: none;
  }
  .connection-list li {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 0.15rem 1rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--hp-border);
    border-radius: var(--hp-radius);
    background: var(--hp-surface);
  }
  .connection-list strong {
    grid-row: span 2;
  }
  .connection-list span {
    color: var(--hp-text-muted);
    font-size: 0.925rem;
  }
  .connection-list code {
    color: var(--hp-text-faint);
    font-size: 0.8rem;
  }
  @media (max-width: 30rem) {
    .connection-list li {
      grid-template-columns: 1fr;
    }
    .connection-list strong {
      grid-row: auto;
    }
  }
</style>
