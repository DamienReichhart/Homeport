---
/**
 * The headline, the download button and a departure board of Hosts. The board
 * is typeset, not a screenshot: every Engine on one board, healthy rows plain,
 * and one red signal where something needs you.
 */
import { REPO_URL } from '@/core/site';
import { getLatestRelease } from '@/core/release';
import { DownloadButton, DownloadMeta } from '@/features/download';
import { href } from '@/shared/lib/href';
import { Icon } from '@/shared/ui';

const release = await getLatestRelease();

interface Row {
  host: string;
  engine: string;
  via: string;
  stacks: number;
  status: string;
  needsYou?: boolean;
}

const rows: Row[] = [
  { host: 'laptop', engine: 'OrbStack', via: 'socket', stacks: 4, status: 'All running' },
  { host: 'homelab', engine: 'Docker Engine 28.5', via: 'ssh', stacks: 9, status: 'All running' },
  { host: 'nas', engine: 'Podman 5.2', via: 'ssh', stacks: 2, status: 'All running' },
  {
    host: 'vps-fra-1',
    engine: 'Docker Engine 27.3',
    via: 'tls',
    stacks: 3,
    status: '1 Stack needs you',
    needsYou: true,
  },
  {
    host: 'client-prod',
    engine: 'Docker Engine 28.1',
    via: 'ssh',
    stacks: 6,
    status: 'All running',
  },
];
---

<section class="hero">
  <div class="container hero__inner">
    {release && (
      <a class="pill" href={href('/changelog/')}>
        <span class="pill__tag">New</span>
        Homeport {release.version} is out
        <Icon name="arrowRight" size={14} />
      </a>
    )}
    <h1>Every container host, on one board.</h1>
    <p class="hero__lead">
      Homeport runs on your machine and reaches your Hosts over SSH, TLS or TCP. No agent on the
      server. Free, open source, Windows, macOS, Linux.
    </p>
    <div class="hero__actions">
      <DownloadButton />
      <a class="button button--secondary button--large" href={REPO_URL}>
        <Icon name="github" />
        Read the source
      </a>
    </div>
    <DownloadMeta />
  </div>

  <div class="container" data-reveal>
    <figure class="board">
      <table>
        <caption class="visually-hidden">
          An example board: five Hosts, their Engines and how Homeport reaches them. One needs
          attention.
        </caption>
        <thead>
          <tr>
            <th scope="col">Host</th>
            <th scope="col" class="board__engine">
              Engine
            </th>
            <th scope="col">Via</th>
            <th scope="col" class="board__num">
              Stacks
            </th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class:list={[row.needsYou && 'is-signal']}>
              <th scope="row">{row.host}</th>
              <td class="board__engine">{row.engine}</td>
              <td class="board__via">{row.via}</td>
              <td class="board__num">{row.stacks}</td>
              <td class="board__status">
                <span>
                  <span class="board__dot" aria-hidden="true" />
                  {row.status}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <figcaption>Healthy is plain. Only what needs you turns red.</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-top: 4.5rem;
  }
  @media (min-width: 64rem) {
    .hero {
      padding-top: 6.5rem;
    }
  }
  .hero__inner {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
  }
  .hero h1 {
    max-width: 14ch;
    font-size: clamp(2.6rem, 1.3rem + 5.4vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .hero__lead {
    max-width: 36rem;
    color: var(--hp-text-muted);
    font-size: clamp(1.05rem, 1rem + 0.35vw, 1.25rem);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  /* The board. .container comes from the global stylesheet; outrank it. */
  .board {
    margin: 4rem 0 0;
  }
  .board table {
    width: 100%;
    border-collapse: collapse;
    border-radius: var(--hp-radius-lg);
    background: var(--hp-board);
    box-shadow: 0 0 0 1px var(--hp-board-edge);
    color: var(--hp-board-text);
    font-size: clamp(0.95rem, 0.85rem + 0.5vw, 1.25rem);
    overflow: hidden;
  }
  .board th,
  .board td {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--hp-board-rule);
    text-align: left;
    white-space: nowrap;
  }
  .board tbody tr:last-child > * {
    border-bottom: 0;
  }
  .board thead th {
    padding-block: 0.85rem;
    color: var(--hp-board-muted);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .board tbody th {
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .board__engine {
    color: var(--hp-board-muted);
  }
  .board__via {
    font-family: var(--sl-font-mono);
    font-size: 0.85em;
  }
  .board__num {
    text-align: right !important;
    font-variant-numeric: tabular-nums;
  }
  .board__status > span {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .board__dot {
    flex: none;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: currentColor;
  }
  .board .is-signal .board__status {
    color: var(--hp-board-signal);
  }
  .board figcaption {
    margin-top: 0.85rem;
    color: var(--hp-text-faint);
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
  }
  @media (max-width: 48rem) {
    .board__engine {
      display: none;
    }
    .board th,
    .board td {
      padding: 0.85rem 0.75rem;
    }
  }
  @media (max-width: 26rem) {
    .board__num {
      display: none;
    }
  }
</style>
