---
/**
 * The first screen, as the first rows of the board: the name, built large with
 * the glyph; what Homeport is and the download; two screens of the app; and the
 * one number that sets it apart (nothing runs on the server).
 */
import { getLatestRelease } from '@/core/release';
import { DownloadButton } from '@/features/download';
import { href } from '@/shared/lib/href';
import { Screenshot } from '@/shared/ui';

const release = await getLatestRelease();
---

<section class="hero board-grid" aria-labelledby="hero-title">
  <div class="tile hero__name">
    <div class="hero__key">
      <svg class="hero__glyph" viewBox="162 376 700 272" aria-hidden="true">
        <rect x="162" y="412" width="200" height="200" fill="currentColor"></rect>
        <rect x="356" y="476" width="240" height="72" fill="currentColor"></rect>
        <circle cx="726" cy="512" r="100" fill="none" stroke="#e1001a" stroke-width="72"></circle>
      </svg>
      <p>
        This machine, the connection, and a Host, drawn hollow because nothing is installed on it.
      </p>
    </div>
    <p class="hero__wordmark">Homeport</p>
  </div>

  <div class="tile tile--strong hero__pitch">
    <h1 id="hero-title">Every Docker Engine, on one board.</h1>
    <p class="hero__lead">
      A free desktop app for the Docker Engines you run, on this machine or on your servers over
      SSH, TLS or TCP. Nothing is installed on the servers.
    </p>
    <div class="hero__actions">
      <DownloadButton tone="inverse" />
      <a href={href('/download/')}>All downloads</a>
    </div>
    <p class="hero__meta">
      {release ? `Version ${release.version}` : 'Latest version'} for Windows, macOS and Linux · MIT
      licence · <a href={href('/changelog/')}>What’s new</a>
    </p>
  </div>

  <div class="tile tile--figure hero__zero">
    <p class="hero__figure" aria-hidden="true">
      0
    </p>
    <p class="hero__figure-text">
      <span class="visually-hidden">Zero</span>
      agents on your servers. Homeport talks to the Engine that is already there.
    </p>
  </div>

  <figure class="tile hero__shot hero__shot--overview">
    <Screenshot
      name="overview"
      alt="Homeport's Overview: three Hosts side by side, prod-eu-1 over SSH, this Mac over its local socket and staging over TLS, each with its containers, images and CPU."
      tile={{ zoom: 1.4, x: 55, y: 6 }}
      sizes="(min-width: 48rem) 800px, 100vw"
      eager
    />
  </figure>

  <figure class="tile hero__shot">
    <Screenshot
      name="containers"
      alt="The Containers page: containers grouped by Stack, with their image, status, ports, CPU and memory."
      tile={{ zoom: 1.6, x: 45, y: 30 }}
      sizes="(min-width: 48rem) 700px, 100vw"
      eager
    />
  </figure>
</section>

<style>
  .hero {
    grid-template-rows: auto;
  }
  .hero__name {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    min-height: 34svh;
  }
  .hero__key {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
  .hero__key p {
    max-width: 26ch;
    font-size: var(--hp-step-small);
    line-height: 1.4;
  }
  .hero__glyph {
    flex: none;
    width: clamp(4.5rem, 3rem + 4vw, 7.5rem);
    height: auto;
    color: var(--hp-text);
  }
  .hero__wordmark {
    margin: 0 0 -0.12em -0.04em;
    font-size: var(--hp-step-display);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.9;
  }
  .hero__pitch {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 1.25rem;
  }
  .hero h1 {
    max-width: 15ch;
    font-size: var(--hp-step-heading);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }
  .hero__lead {
    max-width: 34rem;
    font-size: var(--hp-step-body);
    line-height: 1.5;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 0.5rem;
  }
  .hero__actions a:not(.button),
  .hero__meta a {
    color: inherit;
  }
  .hero__meta {
    color: var(--hp-on-strong-muted);
    font-size: var(--hp-step-small);
  }
  .hero__shot {
    grid-column: 1 / -1;
    margin: 0;
    padding: 0;
    min-height: 16rem;
  }
  .hero__shot--overview :global(img) {
    clip-path: inset(0 0 0 0);
  }
  .hero__zero {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
  }
  .hero__figure {
    font-size: var(--hp-step-display);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.8;
  }
  .hero__figure-text {
    max-width: 22ch;
    font-size: var(--hp-step-body);
    line-height: 1.45;
  }

  @media (min-width: 48rem) {
    .hero__zero {
      grid-column: 1 / 5;
    }
    .hero__shot--overview {
      grid-column: 5 / -1;
      min-height: 20rem;
    }
    .hero__shot:last-child {
      grid-column: 1 / -1;
      min-height: 20rem;
    }
  }
  @media (min-width: 64rem) {
    .hero {
      grid-template-rows: minmax(26rem, calc(58svh - 4rem)) minmax(18rem, 38svh);
    }
    .hero__name {
      grid-column: 1 / 7;
      min-height: 0;
    }
    .hero__pitch {
      grid-column: 7 / -1;
    }
    .hero__zero {
      grid-column: 1 / 4;
    }
    .hero__shot--overview {
      grid-column: 4 / 9;
    }
    .hero__shot:last-child {
      grid-column: 9 / -1;
    }
    .hero__shot,
    .hero__shot--overview,
    .hero__shot:last-child {
      min-height: 0;
    }
  }
  @media (max-width: 47.99rem) {
    .hero__zero,
    .hero__shot:last-child {
      grid-column: span 6;
      order: 1;
    }
  }

  /* The signature move: the first screen of the app opens from its top edge, once. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__shot--overview :global(img) {
      animation: shutter 1.1s cubic-bezier(0.7, 0, 0.2, 1) 0.15s both;
    }
    .hero__pitch > *,
    .hero__name > *,
    .hero__zero > * {
      animation: arrive 0.7s ease both;
    }
    .hero__pitch > :nth-child(2) {
      animation-delay: 80ms;
    }
    .hero__pitch > :nth-child(3) {
      animation-delay: 160ms;
    }
    .hero__pitch > :nth-child(4) {
      animation-delay: 240ms;
    }
    .hero__zero > * {
      animation-delay: 400ms;
    }
  }
  @keyframes shutter {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes arrive {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
