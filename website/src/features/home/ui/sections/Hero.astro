---
/**
 * The hero is the map. A title panel holds the headline, one sentence and the
 * download; from 64rem it sits in the map's top start corner, where the lines
 * leave room for it, like the title block of a transit diagram.
 */
import { strings } from '@/core/i18n';
import { type Locale, localePath } from '@/core/site';
import { DownloadButton, DownloadMeta } from '@/features/download';
import { href } from '@/shared/lib/href';
import LineMap from '../LineMap.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = strings(locale);
---

<section class="hero">
  <div class="container hero__stage">
    <div class="hero__panel">
      <h1>{s['home.hero.title']}</h1>
      <p class="hero__lead">{s['home.hero.lead']}</p>
      <div class="hero__actions">
        <DownloadButton locale={locale} />
        <a class="button button--secondary button--large" href={href(localePath('/docs/', locale))}>
          {s['home.hero.docs']}
        </a>
      </div>
      <DownloadMeta locale={locale} />
    </div>
    <div class="hero__map">
      <LineMap locale={locale} />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 3.5rem 5rem;
  }
  .hero__stage {
    display: grid;
    gap: 3.5rem;
    container-type: inline-size;
  }
  .hero__panel {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    max-width: 36rem;
  }
  .hero h1 {
    font-size: clamp(2.6rem, 1.6rem + 4.6vw, 4.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .hero__lead {
    max-width: 30rem;
    color: var(--hp-text-muted);
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
    line-height: 1.45;
  }
  .hero__actions {
    display: grid;
    gap: 0.75rem;
    width: 100%;
    margin-top: 0.75rem;
  }
  @media (min-width: 30rem) {
    .hero__actions {
      display: flex;
      flex-wrap: wrap;
      width: auto;
    }
  }

  /*
   * From 64rem the panel and the map share one cell: the panel takes the map's
   * top start corner (46% of its width, 60% of its height), which no line enters.
   */
  @media (min-width: 64rem) {
    .hero {
      padding-block: 3rem 6rem;
    }
    .hero__stage {
      grid-template-areas: 'stage';
    }
    .hero__panel,
    .hero__map {
      grid-area: stage;
    }
    .hero__panel {
      z-index: 1;
      align-self: start;
      max-width: 46cqi;
      gap: 1rem;
    }
    .hero h1 {
      font-size: clamp(2.75rem, 5.2cqi, 4.25rem);
    }
    .hero__lead {
      font-size: clamp(1.05rem, 1.65cqi, 1.3rem);
    }
    .hero__actions {
      margin-top: 0.5rem;
    }
  }
  /* The map is drawn left to right in every language, so its free corner is always on the left. */
  @media (min-width: 64rem) {
    :global([dir='rtl']) .hero__panel {
      justify-self: end;
    }
  }
</style>
