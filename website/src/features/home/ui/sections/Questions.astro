---
/**
 * The questions people open Homeport for, as stops on one line: is it up, why
 * did it die, what changed, then the change itself. Each stop answers with a
 * real screenshot of the app.
 */
import { strings } from '@/core/i18n';
import { type Locale, localePath } from '@/core/site';
import { href } from '@/shared/lib/href';
import { Screenshot } from '@/shared/ui';
import { STOP_SIZES } from '../../model/sizes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = strings(locale);

const stops = [
  { id: 'up', shot: 'board', doc: '/docs/guides/overview/' },
  { id: 'died', shot: 'container-logs', doc: '/docs/guides/containers/' },
  { id: 'changed', shot: 'events', doc: '/docs/guides/overview/' },
  { id: 'act', shot: 'stack-editor', doc: '/docs/guides/stacks/' },
] as const;
---

<section class="section section--ruled" id="questions">
  <div class="container">
    <div class="section-head">
      <h2>{s['home.questions.title']}</h2>
      <p>{s['home.questions.lead']}</p>
    </div>

    <ol class="stops">
      {stops.map((stop) => (
        <li class="stop">
          <div class="stop__text">
            <span class="station" aria-hidden="true" />
            <h3>{s[`home.questions.${stop.id}.title`]}</h3>
            <p>{s[`home.questions.${stop.id}.body`]}</p>
            <a class="more-link" href={href(localePath(stop.doc, locale))}>
              {s[`home.questions.${stop.id}.link`]}
            </a>
          </div>
          <Screenshot
            class="stop__shot"
            name={stop.shot}
            folder={locale.code}
            alt={s[`home.questions.${stop.id}.screenshot`]}
            sizes={STOP_SIZES}
          />
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .stops {
    display: grid;
    gap: 5rem;
    margin: 0;
    padding: 0;
    padding-inline-start: 3.5rem;
    list-style: none;
  }
  .stop {
    position: relative;
    display: grid;
    gap: 2rem;
  }
  /* The line runs from each station to the next, so it ends at the last one. */
  .stop:not(:last-child)::before {
    content: '';
    position: absolute;
    inset-inline-start: calc(-3.5rem + 0.7rem - 3px);
    top: 0.9rem;
    bottom: -5.9rem;
    width: var(--hp-line-weight);
    border-radius: 1px;
    background: var(--hp-line-socket);
  }
  .stop__text {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.85rem;
    max-width: 30rem;
  }
  .stop__text .station {
    position: absolute;
    inset-inline-start: -3.5rem;
    top: 0.2rem;
    width: 1.4rem;
    height: 1.4rem;
    border-width: 4px;
  }
  .stop h3 {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    letter-spacing: -0.02em;
  }
  .stop p {
    color: var(--hp-text-muted);
  }
  @media (min-width: 64rem) {
    .stop {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: 4rem;
      align-items: start;
    }
  }
</style>
