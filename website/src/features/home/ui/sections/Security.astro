---
/** How Homeport keeps the credentials it holds. */
import { strings } from '@/core/i18n';
import { type Locale, localePath } from '@/core/site';
import { href } from '@/shared/lib/href';
import { fillHtml } from '@/shared/lib/template';
import { Icon, TextLink } from '@/shared/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = strings(locale);
---

<section class="section">
  <div class="container">
    <div class="section-heading section-heading--center" data-reveal>
      <span class="eyebrow">{s['home.security.eyebrow']}</span>
      <h2>{s['home.security.title']}</h2>
      <p>{s['home.security.lead']}</p>
    </div>
    <div class="security-grid">
      <article class="card security" data-reveal>
        <Icon name="lock" />
        <h3>{s['home.security.rest.title']}</h3>
        <p>{s['home.security.rest.body']}</p>
      </article>
      <article class="card security" data-reveal>
        <Icon name="key" />
        <h3>{s['home.security.disk.title']}</h3>
        <p set:html={fillHtml(s['home.security.disk.body'], { dir: '<code>~/.ssh</code>' })} />
      </article>
      <article class="card security" data-reveal>
        <Icon name="shield" />
        <h3>{s['home.security.home.title']}</h3>
        <p>{s['home.security.home.body']}</p>
      </article>
    </div>
    <p class="center-link">
      <TextLink href={href(localePath('/docs/reference/security/', locale))}>
        {s['home.security.link']}
      </TextLink>
    </p>
  </div>
</section>

<style>
  .center-link {
    margin-top: 2rem;
    text-align: center;
  }
  .center-link :global(.text-link) {
    margin-inline: auto;
  }
  .security-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }
  .security {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: 1.75rem;
  }
  .security > :global(svg) {
    color: var(--hp-text);
  }
  .security h3 {
    font-size: 1.15rem;
  }
  .security p {
    color: var(--hp-text-muted);
  }
  .security code {
    font-size: 0.85em;
  }
</style>
