---
/** The Engines and clusters Homeport works with. */
import { strings } from '@/core/i18n';
import type { Locale } from '@/core/site';

interface Props {
  locale: Locale;
}

const s = strings(Astro.props.locale);
const runtimes = [
  'Docker Engine',
  'Docker Desktop',
  'Colima',
  'OrbStack',
  'Rancher Desktop',
  'Podman',
  'containerd',
  'Incus',
  'Kubernetes',
  'Nomad',
];
---

<section class="runtimes" aria-label={s['home.runtimes.label']}>
  <div class="container runtimes__inner">
    <p>{s['home.runtimes.title']}</p>
    <ul>
      {runtimes.map((name) => (
        <li>{name}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .runtimes {
    padding-block: 3rem 1rem;
  }
  .runtimes__inner {
    display: grid;
    gap: 1rem;
    justify-items: center;
    text-align: center;
  }
  .runtimes p {
    color: var(--hp-text-faint);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .runtimes ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--hp-text-muted);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
</style>
