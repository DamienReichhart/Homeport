---
/** What to know around the install: requirements, first launch, updates and verifying. */
import { strings } from '@/core/i18n';
import { getLatestRelease } from '@/core/release';
import { type Locale, localePath, REPO } from '@/core/site';
import { href } from '@/shared/lib/href';
import { escapeHtml, fillHtml } from '@/shared/lib/template';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = strings(locale);
const release = await getLatestRelease();
const docs = (path: string) => href(localePath(path, locale));
const tag = (name: string, text: string) => `<${name}>${escapeHtml(text)}</${name}>`;
const packages = { deb: '<code>.deb</code>', rpm: '<code>.rpm</code>' };
---

<div class="info-grid">
  <section class="card info prose">
    <h2>{s['download.before.title']}</h2>
    <p>{s['download.before.body']}</p>
    <ul>
      <li
        set:html={fillHtml(s['download.before.keychain'], {
          keychain: tag('strong', s['download.before.keychainName']),
        })}
      />
      <li
        set:html={fillHtml(s['download.before.compose'], {
          tool: '<strong><code>docker compose</code></strong>',
        })}
      />
      <li
        set:html={fillHtml(s['download.before.git'], { tool: '<strong><code>git</code></strong>' })}
      />
    </ul>
    <p
      set:html={fillHtml(s['download.before.optional'], {
        link: `<a href="${docs('/docs/requirements/')}">${escapeHtml(s['download.before.requirements'])}</a>`,
      })}
    />
  </section>

  <section class="card info prose">
    <h2>{s['download.first.title']}</h2>
    <p>{s['download.first.body']}</p>
    <ul>
      <li
        set:html={fillHtml(s['download.first.windows'], {
          os: '<strong>Windows</strong>',
          moreInfo: tag('em', s['download.first.moreInfo']),
          runAnyway: tag('em', s['download.first.runAnyway']),
        })}
      />
      <li
        set:html={fillHtml(s['download.first.macos'], {
          os: '<strong>macOS</strong>',
          settings: tag('em', s['download.first.settings']),
          openAnyway: tag('em', s['download.first.openAnyway']),
        })}
      />
    </ul>
    <p>
      <a href={docs('/docs/installation/')}>{s['download.first.link']}</a>
    </p>
  </section>

  <section class="card info prose">
    <h2>{s['download.updates.title']}</h2>
    <p>{s['download.updates.body']}</p>
    <p set:html={fillHtml(s['download.updates.packages'], packages)} />
    <p>
      <a href={docs('/docs/reference/updating/')}>{s['download.updates.link']}</a>
    </p>
  </section>

  <section class="card info prose">
    <h2>{s['download.verify.title']}</h2>
    <p>{s['download.verify.body']}</p>
    <pre class="code-block"><code>gh attestation verify &lt;file&gt; --repo {REPO}</code></pre>
    <p>
      {release?.checksumsUrl ? (
        <a href={release.checksumsUrl}>SHA256SUMS.txt</a>
      ) : (
        <span>SHA256SUMS.txt</span>
      )}{' '}
      · <a href={docs('/docs/reference/verifying/')}>{s['download.verify.link']}</a>
    </p>
  </section>
</div>

<style>
  .info-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    margin-top: 3rem;
  }
  /* Outrank .prose from the global stylesheet rather than tie with it. */
  .info.prose {
    padding: 1.5rem 1.75rem;
    max-width: none;
  }
  .info.prose h2 {
    margin-top: 0;
    font-size: 1.2rem;
  }
  .info ul {
    padding-inline-start: 1.1rem;
  }
  .info .code-block {
    margin-bottom: 1rem;
    white-space: pre-wrap;
    word-break: break-word;
  }
</style>
