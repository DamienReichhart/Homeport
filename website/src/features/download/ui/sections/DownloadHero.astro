---
/** The download page's title, the version on offer, and a note on the visitor's system. */
import { strings } from '@/core/i18n';
import { getLatestRelease } from '@/core/release';
import { type Locale, localePath, RELEASES_URL } from '@/core/site';
import { formatDate } from '@/shared/lib/format';
import { href } from '@/shared/lib/href';
import { escapeHtml, fillHtml } from '@/shared/lib/template';
import { Icon } from '@/shared/ui';
import type { RecommendationText } from '../../model/recommendation';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = strings(locale);
const release = await getLatestRelease();
const recommendationText: RecommendationText = {
  sentence: s['download.recommend'],
  onArch: s['download.recommend.arch'],
  appleSilicon: s['download.arch.appleSilicon'],
  intel: s['download.arch.intel'],
  arm64: s['download.arch.arm64'],
  x64: s['download.arch.x64'],
};
const link = (url: string, text: string) => `<a href="${url}">${escapeHtml(text)}</a>`;
---

<section class="download-hero">
  <div class="container">
    <span class="eyebrow">{s['download.hero.eyebrow']}</span>
    <h1>{s['download.hero.title']}</h1>
    {release ? (
      <p class="lead">
        <Fragment
          set:html={fillHtml(s['download.hero.release'], {
            version: `<strong>${escapeHtml(release.version)}</strong>`,
            date: escapeHtml(formatDate(release.publishedAt, locale.lang)),
          })}
        />{' '}
        <a href={href(localePath('/changelog/', locale))}>{s['download.hero.whatsNew']}</a>
      </p>
    ) : (
      <p
        class="lead"
        set:html={fillHtml(s['download.hero.noRelease'], {
          link: link(`${RELEASES_URL}/latest`, s['download.hero.releasesPage']),
        })}
      />
    )}
    <p class="recommend" data-recommend data-text={JSON.stringify(recommendationText)} hidden>
      <Icon name="check" size={16} /> <span></span>
    </p>
  </div>
</section>

<script>
  import { detectPlatform } from '../../model/platform';
  import { recommendation, type RecommendationText } from '../../model/recommendation';

  void detectPlatform().then(({ os, arch }) => {
    if (os === 'other') return;
    const note = document.querySelector<HTMLElement>('[data-recommend]');
    const text = note?.querySelector('span');
    if (note?.dataset.text && text) {
      text.textContent = recommendation(
        os,
        arch,
        JSON.parse(note.dataset.text) as RecommendationText,
      );
      note.hidden = false;
    }
  });
</script>

<style>
  .download-hero {
    padding: 4.5rem 0 2.5rem;
  }
  .download-hero .container {
    display: grid;
    gap: 0.85rem;
    justify-items: center;
    text-align: center;
  }
  .download-hero h1 {
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.5rem);
  }
  .lead {
    color: var(--hp-text-muted);
    font-size: 1.15rem;
  }
  .recommend {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--hp-text-muted);
    font-size: 0.9rem;
  }
  .recommend[hidden] {
    display: none;
  }
  .recommend :global(svg) {
    color: var(--hp-primary);
  }
</style>
