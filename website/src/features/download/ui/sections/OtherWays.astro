---
/** Previous versions, building from source, and the installers planned for later. */
import { type StringKey, strings } from '@/core/i18n';
import { COMING_LATER } from '@/core/packages';
import { ISSUES_URL, type Locale, localePath, RELEASES_URL, REPO_URL } from '@/core/site';
import { href } from '@/shared/lib/href';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = strings(locale);
/** What each channel will be, by its name in COMING_LATER; a channel missing here shows its English text. */
const later: Record<string, StringKey> = {
  Homebrew: 'download.later.homebrew',
  winget: 'download.later.winget',
  Scoop: 'download.later.scoop',
  AUR: 'download.later.aur',
  Flathub: 'download.later.flathub',
  Snap: 'download.later.snap',
};
---

<section class="more">
  <h2>{s['download.other.title']}</h2>
  <div class="more__grid">
    <a class="card more__item" href={RELEASES_URL}>
      <strong>{s['download.other.previous.title']}</strong>
      <span>{s['download.other.previous.body']}</span>
    </a>
    <a class="card more__item" href={href(localePath('/docs/project/building/', locale))}>
      <strong>{s['download.other.build.title']}</strong>
      <span>{s['download.other.build.body']}</span>
    </a>
    <a class="card more__item" href={REPO_URL}>
      <strong>{s['download.other.source.title']}</strong>
      <span>{s['download.other.source.body']}</span>
    </a>
  </div>
  <h3 class="more__later">{s['download.later.title']}</h3>
  <ul class="later">
    {COMING_LATER.map((channel) => (
      <li>
        <a href={`${ISSUES_URL}/${channel.issue}`}>{channel.name}</a>
        <span>{later[channel.name] ? s[later[channel.name]!] : channel.what}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .more {
    margin-top: 4rem;
  }
  .more__later {
    margin: 2rem 0 0.75rem;
    font-size: 1.05rem;
  }
  .later {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .later li {
    display: grid;
    gap: 0.1rem;
    font-size: 0.9rem;
  }
  .later span {
    color: var(--hp-text-muted);
    font-size: 0.8rem;
  }
  .more h2 {
    margin-bottom: 1.25rem;
    font-size: 1.35rem;
  }
  .more__grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .more__item {
    display: grid;
    gap: 0.25rem;
    padding: 1.25rem 1.5rem;
    color: var(--hp-text);
    text-decoration: none;
  }
  .more__item:hover {
    border-color: var(--hp-primary);
    color: var(--hp-text);
  }
  .more__item span {
    color: var(--hp-text-muted);
    font-size: 0.9rem;
  }
</style>
