---
/** One platform: its requirements, the Linux repository, its installers and a link to the guide. */
import { strings } from '@/core/i18n';
import type { Release } from '@/core/release';
import { type Locale, localePath } from '@/core/site';
import { href } from '@/shared/lib/href';
import { fill } from '@/shared/lib/template';
import { Icon } from '@/shared/ui';
import type { PlatformInfo } from '../../data/platforms';
import InstallerFiles from './InstallerFiles.astro';
import LinuxRepository from './LinuxRepository.astro';

interface Props {
  platform: PlatformInfo;
  release: Release | undefined;
  locale: Locale;
}

const { platform, release, locale } = Astro.props;
const s = strings(locale);
---

<section class="platform" id={platform.os} data-os={platform.os}>
  <header>
    <Icon name={platform.icon} size={28} />
    <div>
      <h2>{platform.title}</h2>
      <p>{s[platform.requirement]}</p>
    </div>
    <span class="platform__badge" hidden>
      {s['download.platform.yours']}
    </span>
  </header>
  <div class="platform__files">
    {platform.os === 'linux' && <LinuxRepository locale={locale} />}
    <InstallerFiles os={platform.os} release={release} locale={locale} />
  </div>
  <a class="platform__guide" href={href(localePath(`/docs/installation/#${platform.os}`, locale))}>
    {fill(s['download.platform.guide'], { platform: platform.title })}{' '}
    <Icon name="arrowRight" size={14} class="flip-rtl" />
  </a>
</section>

<style>
  .platform {
    display: grid;
    gap: 1.5rem;
    padding-block: 2.25rem 2.5rem;
    border-top: 1px solid var(--hp-border);
    scroll-margin-top: 5.5rem;
  }
  .platform.is-current {
    border-top: 2px solid var(--hp-text);
  }
  @media (min-width: 60rem) {
    .platform {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      grid-template-rows: auto 1fr;
      column-gap: 4rem;
    }
    .platform__files {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    .platform__guide {
      grid-column: 1;
      grid-row: 2;
      align-self: start;
    }
  }
  .platform__files {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
  }
  .platform header {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.25rem 1rem;
    align-items: center;
    align-self: start;
  }
  .platform h2 {
    font-size: 1.75rem;
    letter-spacing: -0.02em;
  }
  .platform header p {
    grid-column: 2;
    color: var(--hp-text-muted);
    line-height: 1.45;
  }
  .platform__badge {
    grid-column: 2;
    justify-self: start;
    margin-top: 0.5rem;
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--hp-text);
    border-radius: var(--hp-radius);
    color: var(--hp-text);
    font-size: 0.85rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .platform__badge[hidden] {
    display: none;
  }
  .platform__guide {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    font-weight: 500;
    text-decoration-color: var(--hp-border-strong);
  }
  .platform__guide:hover {
    text-decoration-color: currentColor;
  }
</style>
