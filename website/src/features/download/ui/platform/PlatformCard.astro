---
/** One platform: its requirements, the Linux repository, its installers and a link to the guide. */
import { strings } from '@/core/i18n';
import type { Release } from '@/core/release';
import { type Locale, localePath } from '@/core/site';
import { href } from '@/shared/lib/href';
import { fill } from '@/shared/lib/template';
import { Icon } from '@/shared/ui';
import type { PlatformInfo } from '../../data/platforms';
import InstallerFiles from './InstallerFiles.astro';
import LinuxRepository from './LinuxRepository.astro';

interface Props {
  platform: PlatformInfo;
  release: Release | undefined;
  locale: Locale;
}

const { platform, release, locale } = Astro.props;
const s = strings(locale);
---

<section class="card platform" id={platform.os} data-os={platform.os}>
  <header>
    <Icon name={platform.icon} size={28} />
    <div>
      <h2>{platform.title}</h2>
      <p>{s[platform.requirement]}</p>
    </div>
    <span class="platform__badge" hidden>
      {s['download.platform.yours']}
    </span>
  </header>
  {platform.os === 'linux' && <LinuxRepository locale={locale} />}
  <InstallerFiles os={platform.os} release={release} locale={locale} />
  <a class="platform__guide" href={href(localePath(`/docs/installation/#${platform.os}`, locale))}>
    {fill(s['download.platform.guide'], { platform: platform.title })}{' '}
    <Icon name="arrowRight" size={14} class="flip-rtl" />
  </a>
</section>

<style>
  .platform {
    display: grid;
    gap: 1.25rem;
    padding: 1.5rem;
    scroll-margin-top: 5.5rem;
  }
  .platform.is-current {
    border-color: var(--hp-text);
    box-shadow: 0 0 0 1px var(--hp-text);
  }
  .platform header {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
  }
  .platform header > :global(svg) {
    flex: none;
    margin-top: 0.15rem;
  }
  .platform h2 {
    font-size: 1.35rem;
  }
  .platform header p {
    color: var(--hp-text-faint);
    font-size: 0.85rem;
    line-height: 1.4;
  }
  .platform__badge {
    margin-inline-start: auto;
    padding: 0.15rem 0.6rem;
    border-radius: 2px;
    background: var(--hp-primary);
    color: var(--hp-on-primary);
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .platform__badge[hidden] {
    display: none;
  }
  .platform__guide {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
  }
</style>
