---
/** A platform's installers: a row per format, a button per architecture, and their checksums. */
import { strings } from '@/core/i18n';
import { type Arch, FORMATS, type Format, type Os, type Release } from '@/core/release';
import { type Locale, RELEASES_URL } from '@/core/site';
import { formatSize } from '@/shared/lib/format';
import { escapeHtml, fill, fillHtml } from '@/shared/lib/template';
import { Icon } from '@/shared/ui';
import { formatsFor } from '../../model/installers';

interface Props {
  os: Os;
  release: Release | undefined;
  locale: Locale;
}

const { os, release, locale } = Astro.props;
const s = strings(locale);
const rows = formatsFor(release, os);
const label = (format: Format) => s[`download.format.${format}.label`];
const archLabel = (os: Os, arch: Arch) =>
  os === 'macos'
    ? s[arch === 'arm64' ? 'download.arch.appleSilicon' : 'download.arch.intel']
    : s[arch === 'arm64' ? 'download.arch.arm64' : 'download.arch.x64'];
---

{rows.length > 0 ? (
  <ul class="files">
    {rows.map(({ format, files }) => (
      <li data-format={format}>
        <div class="files__info">
          <strong>
            {label(format)} <code>{FORMATS[format].ext}</code>
          </strong>
          <span>
            {s[`download.format.${format}.hint`]} · {formatSize(files[0]!.size, locale.lang)}
          </span>
        </div>
        <div class="files__buttons">
          {files.map((file) => (
            <a
              class="button button--secondary button--small"
              href={file.url}
              data-arch={file.arch}
              title={file.name}
            >
              <Icon name="download" size={16} />
              {archLabel(file.os, file.arch)}
              <span class="visually-hidden">
                {fill(s['download.files.file'], { format: label(format), file: file.name })}
              </span>
            </a>
          ))}
        </div>
        {files.some((f) => f.sha256) && (
          <details class="files__sum">
            <summary>{s['download.files.checksums']}</summary>
            {files.map((file) => (
              <p>
                <span>{archLabel(file.os, file.arch)}</span>
                <code>{file.sha256}</code>
              </p>
            ))}
          </details>
        )}
      </li>
    ))}
  </ul>
) : (
  <p
    class="files__empty"
    set:html={fillHtml(s['download.files.none'], {
      link: `<a href="${RELEASES_URL}/latest">${escapeHtml(s['download.files.latest'])}</a>`,
    })}
  />
)}

<style>
  .files {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .files li {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem 1rem;
    align-items: center;
    padding: 0.85rem 0.95rem;
    border: 1px solid var(--hp-border);
    border-radius: var(--hp-radius);
    background: var(--hp-bg-raised);
  }
  .files li.is-best {
    border-color: color-mix(in srgb, var(--hp-primary) 60%, transparent);
  }
  .files__info {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }
  .files__info strong {
    font-size: 0.95rem;
  }
  .files__info code {
    color: var(--hp-text-faint);
    font-size: 0.75rem;
    font-weight: 500;
  }
  .files__info > span {
    color: var(--hp-text-muted);
    font-size: 0.825rem;
    line-height: 1.45;
  }
  .files__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .files__buttons .button {
    white-space: nowrap;
  }
  .files__sum summary {
    width: fit-content;
    color: var(--hp-text-faint);
    font-size: 0.75rem;
    cursor: pointer;
  }
  .files__sum p {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.5rem;
    margin-top: 0.35rem;
    font-size: 0.7rem;
  }
  .files__sum span {
    color: var(--hp-text-faint);
  }
  .files__sum code {
    color: var(--hp-text-muted);
    word-break: break-all;
  }
  .files__empty {
    color: var(--hp-text-muted);
  }
</style>
