---
/** A platform's installers: a row per format, a button per architecture, and their checksums. */
import { strings } from '@/core/i18n';
import { type Arch, FORMATS, type Format, type Os, type Release } from '@/core/release';
import { type Locale, RELEASES_URL } from '@/core/site';
import { formatSize } from '@/shared/lib/format';
import { escapeHtml, fill, fillHtml } from '@/shared/lib/template';
import { Icon } from '@/shared/ui';
import { formatsFor } from '../../model/installers';

interface Props {
  os: Os;
  release: Release | undefined;
  locale: Locale;
}

const { os, release, locale } = Astro.props;
const s = strings(locale);
const rows = formatsFor(release, os);
const label = (format: Format) => s[`download.format.${format}.label`];
const archLabel = (os: Os, arch: Arch) =>
  os === 'macos'
    ? s[arch === 'arm64' ? 'download.arch.appleSilicon' : 'download.arch.intel']
    : s[arch === 'arm64' ? 'download.arch.arm64' : 'download.arch.x64'];
---

{rows.length > 0 ? (
  <ul class="files">
    {rows.map(({ format, files }) => (
      <li data-format={format}>
        <div class="files__info">
          <strong>
            {label(format)} <code>{FORMATS[format].ext}</code>
          </strong>
          <span>{s[`download.format.${format}.hint`]}</span>
          <span class="files__size">{formatSize(files[0]!.size, locale.lang)}</span>
        </div>
        <div class="files__buttons">
          {files.map((file) => (
            <a
              class="button button--secondary button--small"
              href={file.url}
              data-arch={file.arch}
              title={file.name}
            >
              <Icon name="download" size={16} />
              {archLabel(file.os, file.arch)}
              <span class="visually-hidden">
                {fill(s['download.files.file'], { format: label(format), file: file.name })}
              </span>
            </a>
          ))}
        </div>
        {files.some((f) => f.sha256) && (
          <details class="files__sum">
            <summary>{s['download.files.checksums']}</summary>
            {files.map((file) => (
              <p>
                <span>{archLabel(file.os, file.arch)}</span>
                <code>{file.sha256}</code>
              </p>
            ))}
          </details>
        )}
      </li>
    ))}
  </ul>
) : (
  <p
    class="files__empty"
    set:html={fillHtml(s['download.files.none'], {
      link: `<a href="${RELEASES_URL}/latest">${escapeHtml(s['download.files.latest'])}</a>`,
    })}
  />
)}

<style>
  /* One row per format, like a timetable: what it is on the start side, its files on the end. */
  .files {
    display: grid;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hp-border);
    list-style: none;
  }
  .files li {
    display: grid;
    gap: 0.75rem 1.5rem;
    align-items: center;
    padding-block: 1rem;
    border-bottom: 1px solid var(--hp-border);
  }
  @media (min-width: 40rem) {
    .files li {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .files__sum {
      grid-column: 1 / -1;
    }
  }
  .files__info {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }
  .files__info strong {
    font-weight: 600;
  }
  .files__info code {
    margin-inline-start: 0.35rem;
    color: var(--hp-text-faint);
    font-size: 0.8rem;
    font-weight: 400;
  }
  .files__info > span {
    color: var(--hp-text-muted);
    font-size: 0.925rem;
    line-height: 1.45;
  }
  .files__info > .files__size {
    color: var(--hp-text-faint);
    font-variant-numeric: tabular-nums;
  }
  .files__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .files__buttons .button {
    white-space: nowrap;
  }
  .files__sum summary {
    width: fit-content;
    color: var(--hp-text-muted);
    font-size: 0.85rem;
    cursor: pointer;
  }
  .files__sum summary:hover {
    color: var(--hp-text);
  }
  .files__sum p {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 0.5rem;
    margin-top: 0.4rem;
    font-size: 0.8rem;
  }
  .files__sum span {
    color: var(--hp-text-faint);
  }
  .files__sum code {
    color: var(--hp-text-muted);
    word-break: break-all;
  }
  .files__empty {
    color: var(--hp-text-muted);
  }
</style>
