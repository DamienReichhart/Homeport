---
/** This page in every language but English, which is `pages/download.astro`. */
import DownloadPage from '@/app/views/DownloadPage.astro';
import { localeStaticPaths } from '@/core/i18n';
import type { Locale } from '@/core/site';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<DownloadPage locale={locale} />
