---
/** This page in every language but English, which is `pages/changelog.astro`. */
import ChangelogPage from '@/app/views/ChangelogPage.astro';
import { localeStaticPaths } from '@/core/i18n';
import type { Locale } from '@/core/site';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<ChangelogPage locale={locale} />
