---
import SiteLayout from '@/app/layouts/SiteLayout.astro';
import {
  COMING_LATER,
  INSTALL_COMMAND,
  INSTALL_SCRIPT_URL,
  MANUAL_SETUP,
} from '../lib/repository';
import {
  archLabel,
  FORMATS,
  getLatestRelease,
  getReleases,
  type Installer,
  type Os,
} from '@/core/release';
import { ISSUES_URL, RELEASES_URL, REPO, REPO_URL } from '@/core/site';
import { formatDate, formatSize } from '@/shared/lib/format';
import { href } from '@/shared/lib/href';
import { Icon } from '@/shared/ui';

const release = await getLatestRelease();
const prerelease = (await getReleases()).find(
  (r) => r.prerelease && r.installers.length > 0 && (!release || r.publishedAt > release.publishedAt),
);

const platforms: { os: Os; title: string; icon: 'windows' | 'apple' | 'linux'; requirement: string }[] = [
  { os: 'windows', title: 'Windows', icon: 'windows', requirement: 'Windows 10 or 11' },
  { os: 'macos', title: 'macOS', icon: 'apple', requirement: 'macOS 10.15 or later' },
  {
    os: 'linux',
    title: 'Linux',
    icon: 'linux',
    requirement: 'Ubuntu 22.04, Debian 12, Fedora 36 or newer',
  },
];

/** One row per format, with a file per architecture: Apple silicon first on macOS, x64 elsewhere. */
function formatsFor(os: Os): { format: Installer['format']; files: Installer[] }[] {
  const rows = new Map<Installer['format'], Installer[]>();
  for (const file of release?.installers.filter((i) => i.os === os) ?? []) {
    rows.set(file.format, [...(rows.get(file.format) ?? []), file]);
  }
  return [...rows].map(([format, files]) => ({
    format,
    files: files.sort((a, b) => {
      const first = os === 'macos' ? 'arm64' : 'x64';
      return a.arch === first ? -1 : b.arch === first ? 1 : 0;
    }),
  }));
}
---

<SiteLayout
  title="Download Homeport"
  description="Download Homeport for Windows, macOS and Linux — x64 and ARM installers and Linux package repositories, with checksums and build provenance."
>
  <section class="download-hero">
    <div class="container">
      <span class="eyebrow">Download</span>
      <h1>Get Homeport</h1>
      {
        release ? (
          <p class="lead">
            Version <strong>{release.version}</strong>, released {formatDate(release.publishedAt)}.{' '}
            <a href={href('/changelog/')}>What's new</a>
          </p>
        ) : (
          <p class="lead">
            Installers for every platform are on the{' '}
            <a href={`${RELEASES_URL}/latest`}>GitHub releases page</a>.
          </p>
        )
      }
      <p class="recommend" data-recommend hidden>
        <Icon name="check" size={16} /> <span></span>
      </p>
    </div>
  </section>

  <div class="container">
    {
      prerelease && (
        <aside class="notice">
          <strong>Preview available:</strong> {prerelease.name} is a prerelease for testing.{' '}
          <a href={prerelease.url}>Download it from GitHub</a>.
        </aside>
      )
    }

    <div class="platforms">
      {
        platforms.map((platform) => (
          <section class="card platform" id={platform.os} data-os={platform.os}>
            <header>
              <Icon name={platform.icon} size={28} />
              <div>
                <h2>{platform.title}</h2>
                <p>{platform.requirement}</p>
              </div>
              <span class="platform__badge" hidden>
                Your system
              </span>
            </header>
            {platform.os === 'linux' && (
              <div class="repo">
                <div class="repo__intro">
                  <strong>Quick install</strong>
                  <span>
                    Adds the Homeport package repository and installs Homeport, so apt, dnf or
                    zypper keeps it up to date.
                  </span>
                </div>
                <div class="command">
                  <pre class="code-block"><code>{INSTALL_COMMAND}</code></pre>
                  <button
                    type="button"
                    class="button button--secondary button--small"
                    data-copy={INSTALL_COMMAND}
                  >
                    Copy
                  </button>
                </div>
                <p class="repo__note">
                  <a href={INSTALL_SCRIPT_URL}>Read the script</a> first if you like, or set the
                  repository up yourself:
                </p>
                <details class="repo__manual">
                  <summary>Manual setup</summary>
                  {MANUAL_SETUP.map((setup) => (
                    <div class="repo__distro">
                      <strong>{setup.label}</strong>
                      <span>{setup.distributions}</span>
                      <div class="command">
                        <pre class="code-block"><code>{setup.commands}</code></pre>
                        <button
                          type="button"
                          class="button button--secondary button--small"
                          data-copy={setup.commands}
                        >
                          Copy
                        </button>
                      </div>
                    </div>
                  ))}
                </details>
                <p class="repo__note">
                  Or download a package below. The <code>.deb</code> and <code>.rpm</code> add the
                  repository too, so they get updates as well.
                </p>
              </div>
            )}
            {formatsFor(platform.os).length > 0 ? (
              <ul class="files">
                {formatsFor(platform.os).map(({ format, files }) => (
                  <li data-format={format}>
                    <div class="files__info">
                      <strong>
                        {FORMATS[format].label} <code>{FORMATS[format].ext}</code>
                      </strong>
                      <span>
                        {FORMATS[format].hint} · {formatSize(files[0]!.size)}
                      </span>
                    </div>
                    <div class="files__buttons">
                      {files.map((file) => (
                        <a
                          class="button button--secondary button--small"
                          href={file.url}
                          data-arch={file.arch}
                          title={file.name}
                        >
                          <Icon name="download" size={16} />
                          {archLabel(file.os, file.arch)}
                          <span class="visually-hidden">{FORMATS[format].label} ({file.name})</span>
                        </a>
                      ))}
                    </div>
                    {files.some((f) => f.sha256) && (
                      <details class="files__sum">
                        <summary>SHA-256 checksums</summary>
                        {files.map((file) => (
                          <p>
                            <span>{archLabel(file.os, file.arch)}</span>
                            <code>{file.sha256}</code>
                          </p>
                        ))}
                      </details>
                    )}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="files__empty">
                See the <a href={`${RELEASES_URL}/latest`}>latest release on GitHub</a>.
              </p>
            )}
            <a class="platform__guide" href={href(`/docs/installation/#${platform.os}`)}>
              Installation guide for {platform.title} <Icon name="arrowRight" size={14} />
            </a>
          </section>
        ))
      }
    </div>

    <div class="info-grid">
      <section class="card info prose">
        <h2>Before you install</h2>
        <p>
          Homeport manages Docker Engines — it doesn't include one. Run it next to Docker Engine,
          Docker Desktop, Colima, OrbStack, Rancher Desktop or Podman, or point it at a remote
          server over SSH, TLS or TCP.
        </p>
        <ul>
          <li>
            <strong>OS keychain</strong> (macOS Keychain, Windows Credential Manager, or a Secret
            Service such as GNOME Keyring) to store SSH keys, TLS certificates and Stack environments.
          </li>
          <li>
            <strong><code>docker compose</code></strong> on this machine to deploy Managed Stacks.
          </li>
        </ul>
        <p>
          Both are optional: Homeport tells you what is unavailable without them. See the{' '}
          <a href={href('/docs/requirements/')}>system requirements</a>.
        </p>
      </section>

      <section class="card info prose">
        <h2>First launch</h2>
        <p>
          The installers are not yet signed with a paid certificate, so your system may ask for
          confirmation once:
        </p>
        <ul>
          <li>
            <strong>Windows</strong>: SmartScreen shows “Windows protected your PC”. Choose{' '}
            <em>More info</em>, then <em>Run anyway</em>.
          </li>
          <li>
            <strong>macOS</strong>: if Homeport “can't be opened”, allow it in{' '}
            <em>System Settings → Privacy &amp; Security</em> and choose <em>Open Anyway</em>.
          </li>
        </ul>
        <p>
          <a href={href('/docs/installation/')}>Step-by-step instructions</a>
        </p>
      </section>

      <section class="card info prose">
        <h2>Staying up to date</h2>
        <p>
          On Windows, macOS and with the AppImage, Homeport tells you when a new version is out and
          installs it when you choose. Every update is signed and checked before it's installed.
        </p>
        <p>
          The <code>.deb</code> and <code>.rpm</code> packages update with the rest of your system,
          from the Homeport package repository.
        </p>
        <p>
          <a href={href('/docs/reference/updating/')}>How updates work</a>
        </p>
      </section>

      <section class="card info prose">
        <h2>Verify your download</h2>
        <p>
          Every release is built by GitHub Actions from the public source, with a SHA-256 checksum
          and a signed build provenance attestation for each file.
        </p>
        <pre class="code-block"><code>gh attestation verify &lt;file&gt; --repo {REPO}</code></pre>
        <p>
          {
            release?.checksumsUrl ? (
              <a href={release.checksumsUrl}>SHA256SUMS.txt</a>
            ) : (
              <span>SHA256SUMS.txt</span>
            )
          }{' '}
          · <a href={href('/docs/reference/verifying/')}>How to verify</a>
        </p>
      </section>
    </div>

    <section class="more">
      <h2>Other ways to get Homeport</h2>
      <div class="more__grid">
        <a class="card more__item" href={RELEASES_URL}>
          <strong>Previous versions</strong>
          <span>Every release, with notes and files, on GitHub.</span>
        </a>
        <a class="card more__item" href={href('/docs/project/building/')}>
          <strong>Build from source</strong>
          <span>Bun, Rust and the Tauri prerequisites.</span>
        </a>
        <a class="card more__item" href={REPO_URL}>
          <strong>Source code</strong>
          <span>MIT licensed, on GitHub.</span>
        </a>
      </div>
      <h3 class="more__later">Coming later</h3>
      <ul class="later">
        {
          COMING_LATER.map((channel) => (
            <li>
              <a href={`${ISSUES_URL}/${channel.issue}`}>{channel.name}</a>
              <span>{channel.what}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</SiteLayout>

<script>
  import { detectPlatform } from '../lib/platform';

  const NAMES: Record<string, string> = { windows: 'Windows', macos: 'macOS', linux: 'Linux' };

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.addEventListener('click', () => {
      void navigator.clipboard.writeText(button.dataset.copy ?? '').then(() => {
        button.textContent = 'Copied';
        setTimeout(() => (button.textContent = 'Copy'), 1500);
      });
    });
  }

  void detectPlatform().then(({ os, arch }) => {
    if (os === 'other') return;
    const card = document.querySelector<HTMLElement>(`.platform[data-os="${os}"]`);
    if (!card) return;
    card.classList.add('is-current');
    card.querySelector<HTMLElement>('.platform__badge')?.removeAttribute('hidden');
    // Put the visitor's platform first.
    card.parentElement?.prepend(card);

    // Highlight the visitor's architecture, and the first format for it.
    if (arch) {
      const buttons = card.querySelectorAll<HTMLElement>(`.files__buttons [data-arch="${arch}"]`);
      buttons.forEach((b) => b.classList.add('is-arch'));
      buttons[0]?.classList.replace('button--secondary', 'button--primary');
      buttons[0]?.closest('li')?.classList.add('is-best');
    }

    const note = document.querySelector<HTMLElement>('[data-recommend]');
    const text = note?.querySelector('span');
    if (note && text) {
      const archText =
        os === 'macos'
          ? arch === 'arm64'
            ? ' on Apple silicon'
            : arch === 'x64'
              ? ' on Intel'
              : ''
          : arch === 'arm64'
            ? ' on ARM64'
            : arch === 'x64'
              ? ' on x64'
              : '';
      text.textContent = `You're on ${NAMES[os]}${archText}. We've put its downloads first.`;
      note.hidden = false;
    }
  });
</script>

<style>
  .download-hero {
    padding: 4.5rem 0 2.5rem;
    background: radial-gradient(50rem 20rem at 50% -6rem, var(--hp-glow), transparent 70%);
  }
  .download-hero .container {
    display: grid;
    gap: 0.85rem;
    justify-items: center;
    text-align: center;
  }
  .download-hero h1 {
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.5rem);
  }
  .lead {
    color: var(--hp-text-muted);
    font-size: 1.15rem;
  }
  .recommend {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--hp-text-muted);
    font-size: 0.9rem;
  }
  .recommend[hidden] {
    display: none;
  }
  .recommend :global(svg) {
    color: var(--hp-primary);
  }

  .notice {
    margin-bottom: 1.5rem;
    padding: 0.9rem 1.15rem;
    border: 1px solid color-mix(in srgb, var(--hp-beacon) 45%, transparent);
    border-radius: var(--hp-radius);
    background: color-mix(in srgb, var(--hp-beacon) 8%, transparent);
  }

  .platforms {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    align-items: start;
  }
  .platform {
    display: grid;
    gap: 1.25rem;
    padding: 1.5rem;
    scroll-margin-top: 5.5rem;
  }
  .platform.is-current {
    border-color: var(--hp-primary);
    box-shadow: 0 0 0 1px var(--hp-primary), 0 20px 50px -30px var(--hp-glow);
  }
  .platform header {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
  }
  .platform header > :global(svg) {
    flex: none;
    margin-top: 0.15rem;
  }
  .platform h2 {
    font-size: 1.35rem;
  }
  .platform header p {
    color: var(--hp-text-faint);
    font-size: 0.85rem;
    line-height: 1.4;
  }
  .platform__badge {
    margin-left: auto;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--hp-primary) 15%, transparent);
    color: var(--hp-primary);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .platform__badge[hidden] {
    display: none;
  }
  .platform__guide {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
  }

  .files {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .files li {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem 1rem;
    align-items: center;
    padding: 0.85rem 0.95rem;
    border: 1px solid var(--hp-border);
    border-radius: var(--hp-radius);
    background: var(--hp-bg-raised);
  }
  .files li.is-best {
    border-color: color-mix(in srgb, var(--hp-primary) 60%, transparent);
  }
  .files__info {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }
  .files__info strong {
    font-size: 0.95rem;
  }
  .files__info code {
    color: var(--hp-text-faint);
    font-size: 0.75rem;
    font-weight: 500;
  }
  .files__info > span {
    color: var(--hp-text-muted);
    font-size: 0.825rem;
    line-height: 1.45;
  }
  .files__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .files__buttons .button {
    white-space: nowrap;
  }
  .files__sum summary {
    width: fit-content;
    color: var(--hp-text-faint);
    font-size: 0.75rem;
    cursor: pointer;
  }
  .files__sum p {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.5rem;
    margin-top: 0.35rem;
    font-size: 0.7rem;
  }
  .files__sum span {
    color: var(--hp-text-faint);
  }
  .files__sum code {
    color: var(--hp-text-muted);
    word-break: break-all;
  }
  .files__empty {
    color: var(--hp-text-muted);
  }

  .info-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    margin-top: 3rem;
  }
  .info {
    padding: 1.5rem 1.75rem;
    max-width: none;
  }
  .info.prose h2 {
    margin-top: 0;
    font-size: 1.2rem;
  }
  .info ul {
    padding-left: 1.1rem;
  }
  .info .code-block {
    margin-bottom: 1rem;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .repo {
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--hp-primary) 45%, transparent);
    border-radius: var(--hp-radius);
    background: color-mix(in srgb, var(--hp-primary) 5%, var(--hp-bg-raised));
  }
  .repo__intro {
    display: grid;
    gap: 0.15rem;
  }
  .repo__intro span,
  .repo__note,
  .repo__distro > span {
    color: var(--hp-text-muted);
    font-size: 0.825rem;
    line-height: 1.45;
  }
  .repo__note code {
    font-size: 0.75rem;
  }
  .command {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem;
    align-items: start;
  }
  .command .code-block {
    padding: 0.6rem 0.8rem;
    font-size: 0.75rem;
    line-height: 1.6;
    white-space: pre;
  }
  .repo__manual summary {
    width: fit-content;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
  }
  .repo__distro {
    display: grid;
    gap: 0.3rem;
    margin-top: 0.85rem;
  }
  .repo__distro strong {
    font-size: 0.875rem;
  }

  .more {
    margin-top: 4rem;
  }
  .more__later {
    margin: 2rem 0 0.75rem;
    font-size: 1.05rem;
  }
  .later {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .later li {
    display: grid;
    gap: 0.1rem;
    font-size: 0.9rem;
  }
  .later span {
    color: var(--hp-text-muted);
    font-size: 0.8rem;
  }
  .more h2 {
    margin-bottom: 1.25rem;
    font-size: 1.35rem;
  }
  .more__grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .more__item {
    display: grid;
    gap: 0.25rem;
    padding: 1.25rem 1.5rem;
    color: var(--hp-text);
    text-decoration: none;
  }
  .more__item:hover {
    border-color: var(--hp-primary);
    color: var(--hp-text);
  }
  .more__item span {
    color: var(--hp-text-muted);
    font-size: 0.9rem;
  }
</style>
