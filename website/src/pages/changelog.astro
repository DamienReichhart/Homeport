---
import { marked } from 'marked';
import SiteLayout from '../layouts/SiteLayout.astro';
import { formatDate, getReleases } from '../lib/releases';
import { RELEASES_URL } from '@/core/site';
import { href } from '@/shared/lib/href';

const releases = await getReleases();

/**
 * Release notes are written by scripts/release.ts from Conventional Commits. The
 * download table at the end is for GitHub; the download page covers it here.
 */
function notes(body: string): string {
  const withoutDownloads = body.split(/^## Download\b/m)[0] ?? body;
  // Demote headings so each release's own title stays the page's h2.
  const demoted = withoutDownloads.replace(/^(#{1,4}) /gm, (_, hashes: string) => `${hashes}# `);
  return marked.parse(demoted, { async: false, gfm: true });
}
---

<SiteLayout
  title="Changelog — Homeport"
  description="What's new in each Homeport release: features, fixes and other changes."
>
  <section class="changelog-hero">
    <div class="container">
      <span class="eyebrow">Changelog</span>
      <h1>What's new in Homeport</h1>
      <p>
        Every release, newest first. Notes are generated from the project's commits; the files are
        on the <a href={href('/download/')}>download page</a>.
      </p>
    </div>
  </section>

  <div class="container">
    {
      releases.length === 0 ? (
        <p class="empty">
          The release history is on <a href={RELEASES_URL}>GitHub</a>.
        </p>
      ) : (
        <ol class="timeline">
          {releases.map((release, index) => (
            <li class="entry" id={release.tag}>
              <div class="entry__meta">
                <a class="entry__version" href={`#${release.tag}`}>
                  {release.version}
                </a>
                <time datetime={release.publishedAt}>{formatDate(release.publishedAt)}</time>
                {index === 0 && !release.prerelease && <span class="tag tag--latest">Latest</span>}
                {release.prerelease && <span class="tag">Prerelease</span>}
              </div>
              <article class="entry__body prose">
                <h2>{release.name}</h2>
                <Fragment set:html={notes(release.body)} />
                <p class="entry__links">
                  <a href={release.url}>Release on GitHub</a>
                  {release.installers.length > 0 && (
                    <>
                      {' · '}
                      <a href={href('/download/')}>Download</a>
                    </>
                  )}
                </p>
              </article>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</SiteLayout>

<style>
  .changelog-hero {
    padding: 4.5rem 0 3rem;
  }
  .changelog-hero .container {
    display: grid;
    gap: 0.85rem;
    max-width: 52rem;
  }
  .changelog-hero h1 {
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.5rem);
  }
  .changelog-hero p {
    color: var(--hp-text-muted);
    font-size: 1.1rem;
  }
  .empty {
    color: var(--hp-text-muted);
  }

  .timeline {
    max-width: 52rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .entry {
    display: grid;
    gap: 1rem;
    padding: 2.5rem 0;
    border-top: 1px solid var(--hp-border);
    scroll-margin-top: 5rem;
  }
  @media (min-width: 48rem) {
    .entry {
      grid-template-columns: 10rem 1fr;
      gap: 2.5rem;
    }
    .entry__meta {
      position: sticky;
      top: 5.5rem;
      align-self: start;
    }
  }
  .entry__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    align-items: center;
  }
  @media (min-width: 48rem) {
    .entry__meta {
      display: grid;
      justify-items: start;
    }
  }
  .entry__version {
    color: var(--hp-text);
    font-family: var(--sl-font-mono);
    font-size: 1.25rem;
    font-weight: 600;
    text-decoration: none;
  }
  .entry__meta time {
    color: var(--hp-text-faint);
    font-size: 0.875rem;
  }
  .tag {
    padding: 0.1rem 0.55rem;
    border: 1px solid var(--hp-border-strong);
    border-radius: 999px;
    color: var(--hp-text-muted);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .tag--latest {
    border-color: transparent;
    background: color-mix(in srgb, var(--hp-primary) 15%, transparent);
    color: var(--hp-primary);
  }
  /* .prose comes from the global stylesheet: outrank it rather than rely on the order of the CSS chunks. */
  .entry__body.prose {
    max-width: none;
  }
  .entry__body.prose h2 {
    margin-top: 0;
  }
  .entry__body :global(h3) {
    color: var(--hp-text);
  }
  .entry__body :global(ul) {
    padding-left: 1.2rem;
  }
  .entry__body :global(li a) {
    color: var(--hp-text-faint);
    font-family: var(--sl-font-mono);
    font-size: 0.8em;
    font-weight: 400;
    text-decoration: none;
  }
  .entry__links {
    margin-top: 1.5rem !important;
    font-size: 0.9rem;
  }
</style>
