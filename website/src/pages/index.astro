---
import DownloadButton from '../components/DownloadButton.astro';
import DownloadMeta from '../components/DownloadMeta.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import Screenshot from '../components/Screenshot.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getLatestRelease } from '../lib/releases';
import { DESCRIPTION, href, REPO_URL, TAGLINE } from '../lib/site';

const release = await getLatestRelease();

const runtimes = [
  'Docker Engine',
  'Docker Desktop',
  'Colima',
  'OrbStack',
  'Rancher Desktop',
  'Podman',
];

const features: { icon: IconName; title: string; body: string }[] = [
  {
    icon: 'server',
    title: 'Hosts, near and far',
    body: 'Local engines are found for you. Remote ones join over SSH, mutual TLS or TCP, and each Host reconnects on its own when the network blinks.',
  },
  {
    icon: 'box',
    title: 'Containers at a glance',
    body: 'Grouped by Stack, with live CPU and memory. Start, stop, restart, pause or remove one container or twenty at once.',
  },
  {
    icon: 'boxes',
    title: 'Compose Stacks',
    body: 'Write a compose file, keep its environment encrypted and deploy it to any Host. Stacks deployed elsewhere show up too, ready to adopt.',
  },
  {
    icon: 'layers',
    title: 'Images',
    body: 'Pull with per-layer progress, tag, inspect the layer history, run straight from the list, and clear out what nothing uses.',
  },
  {
    icon: 'hardDrive',
    title: 'Volumes and networks',
    body: 'See which containers use what. Create, connect and disconnect, with deletion that tells you exactly what you are about to lose.',
  },
  {
    icon: 'activity',
    title: 'Overview and events',
    body: 'Every Host on one page: engine details, disk usage with a one-dialog clean-up, and a live stream of what the Engine is doing.',
  },
];

const containerTools: { icon: IconName; title: string; body: string }[] = [
  { icon: 'fileText', title: 'Logs', body: 'Follow, search, filter by stream and time, download.' },
  { icon: 'terminal', title: 'Terminal', body: 'Interactive shells, as many as you need.' },
  { icon: 'folder', title: 'Files', body: 'Browse, upload and download, folders as .tar.' },
  { icon: 'gauge', title: 'Stats', body: 'CPU, memory, network and disk I/O charts.' },
];

const connections = [
  {
    name: 'Local socket',
    detail: 'Unix sockets and Windows named pipes, detected automatically.',
    code: '/var/run/docker.sock',
  },
  {
    name: 'SSH',
    detail: 'A dedicated Ed25519 key per Host, or your own key or ssh-agent.',
    code: 'deploy@server.example.com',
  },
  {
    name: 'TLS',
    detail: 'Mutual TLS with your CA, client certificate and key.',
    code: 'docker.example.com:2376',
  },
  {
    name: 'TCP',
    detail: 'Plain TCP, for engines on a network you trust.',
    code: '192.168.1.10:2375',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Homeport',
  description: DESCRIPTION,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Windows, macOS, Linux',
  license: 'https://opensource.org/licenses/MIT',
  url: new URL(href('/'), Astro.site).href,
  downloadUrl: new URL(href('/download/'), Astro.site).href,
  codeRepository: REPO_URL,
  ...(release && { softwareVersion: release.version }),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: 'Damien Reichhart' },
};
---

<SiteLayout title={`Homeport — ${TAGLINE}`} jsonLd={jsonLd}>
  <section class="hero">
    <div class="hero__backdrop" aria-hidden="true"></div>
    <div class="container hero__inner">
      {
        release && (
          <a class="pill" href={href('/changelog/')}>
            <span class="pill__tag">New</span>
            Homeport {release.version} is out
            <Icon name="arrowRight" size={14} />
          </a>
        )
      }
      <h1>
        Every Docker Engine,<br /><span>docked in one place.</span>
      </h1>
      <p class="hero__lead">
        Homeport is a desktop app for the Docker Engines you run — on this machine, or on servers
        you reach over SSH, TLS or TCP. Containers, images, volumes, networks and Compose Stacks,
        side by side, without a terminal open for every Host.
      </p>
      <div class="hero__actions">
        <DownloadButton />
        <a class="button button--secondary button--large" href={href('/docs/')}>
          <Icon name="book" />
          Read the docs
        </a>
      </div>
      <DownloadMeta />
      <p class="hero__facts">
        <span><Icon name="check" size={16} /> Free and open source</span>
        <span><Icon name="check" size={16} /> No account</span>
        <span><Icon name="check" size={16} /> Windows, macOS and Linux</span>
      </p>
    </div>
    <div class="container hero__shot" data-reveal>
      <Screenshot
        name="overview"
        alt="Homeport's Overview: a card for each Host with its containers, CPU and memory, the Engine's details and disk usage."
        eager
      />
    </div>
  </section>

  <section class="runtimes" aria-label="Works with">
    <div class="container runtimes__inner">
      <p>Works with the engine you already run</p>
      <ul>{runtimes.map((name) => <li>{name}</li>)}</ul>
    </div>
  </section>

  <section class="section" id="features">
    <div class="container">
      <div class="section-heading section-heading--center" data-reveal>
        <span class="eyebrow">Features</span>
        <h2>Everything your engines run, in one window</h2>
        <p>
          The day-to-day of Docker — what is running, what it says, what it costs — without
          remembering which server it lives on.
        </p>
      </div>
      <div class="feature-grid">
        {
          features.map((feature) => (
            <article class="card feature" data-reveal>
              <span class="feature-icon">
                <Icon name={feature.icon} />
              </span>
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--raised">
    <div class="container split">
      <div class="split__text" data-reveal>
        <span class="eyebrow">Hosts</span>
        <h2>Remote engines without the ceremony</h2>
        <p>
          Add a server once and it stays docked. For SSH, Homeport makes a key just for that Host
          and hands you the one command that authorises it. It checks the server's fingerprint on
          first contact, and warns you if it ever changes.
        </p>
        <ul class="connection-list">
          {
            connections.map((c) => (
              <li>
                <strong>{c.name}</strong>
                <span>{c.detail}</span>
                <code>{c.code}</code>
              </li>
            ))
          }
        </ul>
        <a class="text-link" href={href('/docs/hosts/')}>
          How connections work <Icon name="arrowRight" size={16} />
        </a>
      </div>
      <div class="split__media" data-reveal>
        <Screenshot
          name="add-host-ssh"
          alt="The Add host page with SSH selected: server, port, user, remote socket path and a new key for this Host."
          crop="960 / 820"
          sizes="(min-width: 64rem) 760px, 100vw"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split split--reverse">
      <div class="split__text" data-reveal>
        <span class="eyebrow">Containers</span>
        <h2>Everything about a container, one click away</h2>
        <p>
          Open a container and its logs are already streaming. Switch tabs for an interactive
          terminal, its files, live charts, processes and the full inspect document — on a Host
          across the world as easily as on your laptop.
        </p>
        <ul class="tool-grid">
          {
            containerTools.map((tool) => (
              <li>
                <Icon name={tool.icon} />
                <div>
                  <strong>{tool.title}</strong>
                  <span>{tool.body}</span>
                </div>
              </li>
            ))
          }
        </ul>
        <a class="text-link" href={href('/docs/guides/containers/')}>
          Working with containers <Icon name="arrowRight" size={16} />
        </a>
      </div>
      <div class="split__media" data-reveal>
        <Screenshot
          name="container-logs"
          alt="A container's Logs tab, streaming output with search, timestamps and stream filters."
          sizes="(min-width: 64rem) 760px, 100vw"
        />
      </div>
    </div>
  </section>

  <section class="section section--raised">
    <div class="container split">
      <div class="split__text" data-reveal>
        <span class="eyebrow">Stacks</span>
        <h2>Compose Stacks, managed or found</h2>
        <p>
          Keep a compose file and its environment in Homeport and deploy it to any Host — the
          definition is checked as you type, and variables are stored encrypted, never written to
          disk. Stacks someone deployed by hand show up too: start, stop or remove them, or adopt
          them to edit and redeploy.
        </p>
        <a class="text-link" href={href('/docs/guides/stacks/')}>
          Managing Stacks <Icon name="arrowRight" size={16} />
        </a>
      </div>
      <div class="split__media" data-reveal>
        <Screenshot
          name="stack-editor"
          alt="A Managed Stack's definition: the compose.yaml editor, its environment and the Save and redeploy button."
          sizes="(min-width: 64rem) 760px, 100vw"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading section-heading--center" data-reveal>
        <span class="eyebrow">Security</span>
        <h2>Your keys stay sealed</h2>
        <p>
          Homeport handles the credentials that open your servers, so it treats them that way.
        </p>
      </div>
      <div class="security-grid">
        <article class="card security" data-reveal>
          <Icon name="lock" />
          <h3>Encrypted at rest</h3>
          <p>
            SSH keys, TLS certificates and Stack environments are sealed with XChaCha20-Poly1305.
            The key lives in your OS keychain, not next to the data.
          </p>
        </article>
        <article class="card security" data-reveal>
          <Icon name="key" />
          <h3>Never on disk in clear</h3>
          <p>
            Homeport speaks SSH itself, so decrypted keys stay in memory. No key files, no changes
            to your <code>~/.ssh</code>.
          </p>
        </article>
        <article class="card security" data-reveal>
          <Icon name="shield" />
          <h3>Nothing phones home</h3>
          <p>
            No account, no telemetry, no tracking. Homeport talks to your engines and nothing else.
            Every release is built in the open, with checksums and build provenance.
          </p>
        </article>
      </div>
      <p class="center-link">
        <a class="text-link" href={href('/docs/reference/security/')}>
          Security and your data <Icon name="arrowRight" size={16} />
        </a>
      </p>
    </div>
  </section>

  <section class="section section--raised">
    <div class="container">
      <div class="section-heading section-heading--center" data-reveal>
        <span class="eyebrow">Download</span>
        <h2>Native on every desktop</h2>
        <p>
          A small, fast app built with Tauri and Rust — not a browser tab in disguise. Installers
          for x64 and ARM.
        </p>
      </div>
      <div class="platform-grid">
        <a class="card platform" href={href('/download/#windows')} data-reveal>
          <Icon name="windows" size={32} />
          <h3>Windows</h3>
          <p>10 and 11 · x64 and ARM64</p>
          <span>Installer (.exe) · MSI</span>
        </a>
        <a class="card platform" href={href('/download/#macos')} data-reveal>
          <Icon name="apple" size={32} />
          <h3>macOS</h3>
          <p>Apple silicon and Intel</p>
          <span>Disk image (.dmg)</span>
        </a>
        <a class="card platform" href={href('/download/#linux')} data-reveal>
          <Icon name="linux" size={32} />
          <h3>Linux</h3>
          <p>x64 and ARM64</p>
          <span>.deb · .rpm · AppImage</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta card" data-reveal>
        <div class="cta__text">
          <h2>Bring your engines home.</h2>
          <p>
            Homeport is free, open source under the MIT licence, and built in the open on GitHub.
            Issues, ideas and pull requests are welcome.
          </p>
        </div>
        <div class="cta__actions">
          <DownloadButton />
          <a class="button button--secondary button--large" href={REPO_URL}>
            <Icon name="github" />
            View on GitHub
          </a>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  // Reveal sections as they scroll in. Without JS (or with reduced motion) they're simply visible.
  if (
    'IntersectionObserver' in window &&
    !matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    document.documentElement.classList.add('reveal-ready');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -8% 0px' },
    );
    document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: 4.5rem;
  }
  @media (min-width: 64rem) {
    .hero {
      padding-top: 6rem;
    }
  }
  .hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60rem 30rem at 50% -8rem, var(--hp-glow), transparent 70%),
      radial-gradient(30rem 20rem at 85% 10rem, color-mix(in srgb, var(--hp-beacon) 9%, transparent), transparent 70%);
  }
  .hero__backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--hp-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--hp-border) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 70% 55% at 50% 0%, #000 30%, transparent 75%);
    opacity: 0.6;
  }
  .hero__inner {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    text-align: center;
  }
  .hero h1 {
    max-width: 18ch;
    font-size: clamp(2.6rem, 1.4rem + 5vw, 4.75rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.02;
  }
  .hero h1 span {
    background: linear-gradient(90deg, var(--hp-primary), var(--hp-tide) 60%, var(--hp-primary));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  [data-theme='light'] .hero h1 span {
    background: linear-gradient(90deg, #00578a, var(--hp-harbour) 50%, #1a8bc7);
    -webkit-background-clip: text;
    background-clip: text;
  }
  .hero__lead {
    max-width: 40rem;
    color: var(--hp-text-muted);
    font-size: clamp(1.05rem, 1rem + 0.35vw, 1.25rem);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    color: var(--hp-text-muted);
    font-size: 0.9rem;
  }
  .hero__facts span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .hero__facts :global(svg) {
    color: var(--hp-primary);
  }
  .hero__shot {
    margin-top: 3.5rem;
    max-width: 76rem;
  }
  .hero__shot :global(.window) {
    border-radius: 1rem;
    box-shadow:
      0 0 0 1px var(--hp-border),
      0 30px 80px -30px var(--hp-glow),
      var(--hp-shadow);
  }

  .runtimes {
    padding-block: 3rem 1rem;
  }
  .runtimes__inner {
    display: grid;
    gap: 1rem;
    justify-items: center;
    text-align: center;
  }
  .runtimes p {
    color: var(--hp-text-faint);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .runtimes ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--hp-text-muted);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .feature-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .feature {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1.75rem;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }
  .feature:hover {
    border-color: var(--hp-border-strong);
    transform: translateY(-2px);
  }
  .feature h3 {
    margin-top: 0.5rem;
    font-size: 1.15rem;
  }
  .feature p {
    color: var(--hp-text-muted);
  }

  .split {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 64rem) {
    .split {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: 3.5rem;
    }
    .split--reverse {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    }
    .split--reverse .split__text {
      order: 2;
    }
  }
  .split__text {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .split__text h2 {
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
  }
  .split__text > p {
    color: var(--hp-text-muted);
    font-size: 1.075rem;
  }

  .connection-list {
    display: grid;
    gap: 0.5rem;
    margin: 0.5rem 0;
    padding: 0;
    list-style: none;
  }
  .connection-list li {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 0.15rem 1rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--hp-border);
    border-radius: var(--hp-radius);
    background: var(--hp-surface);
  }
  .connection-list strong {
    grid-row: span 2;
  }
  .connection-list span {
    color: var(--hp-text-muted);
    font-size: 0.925rem;
  }
  .connection-list code {
    color: var(--hp-text-faint);
    font-size: 0.8rem;
  }
  @media (max-width: 30rem) {
    .connection-list li {
      grid-template-columns: 1fr;
    }
    .connection-list strong {
      grid-row: auto;
    }
  }

  .tool-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    margin: 0.5rem 0;
    padding: 0;
    list-style: none;
  }
  .tool-grid li {
    display: flex;
    gap: 0.75rem;
  }
  .tool-grid li > :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--hp-primary);
  }
  .tool-grid strong {
    display: block;
  }
  .tool-grid span {
    color: var(--hp-text-muted);
    font-size: 0.925rem;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    font-weight: 600;
    text-decoration: none;
  }
  .text-link :global(svg) {
    transition: transform 0.15s ease;
  }
  .text-link:hover :global(svg) {
    transform: translateX(3px);
  }
  .center-link {
    margin-top: 2rem;
    text-align: center;
  }
  .center-link .text-link {
    margin-inline: auto;
  }

  .security-grid,
  .platform-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }
  .security {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: 1.75rem;
  }
  .security > :global(svg) {
    color: var(--hp-beacon);
  }
  .security h3 {
    font-size: 1.15rem;
  }
  .security p {
    color: var(--hp-text-muted);
  }
  .security code {
    font-size: 0.85em;
  }

  .platform {
    display: grid;
    gap: 0.4rem;
    justify-items: center;
    padding: 2rem 1.5rem;
    color: var(--hp-text);
    text-align: center;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }
  .platform:hover {
    border-color: var(--hp-primary);
    color: var(--hp-text);
    transform: translateY(-2px);
  }
  .platform > :global(svg) {
    margin-bottom: 0.5rem;
  }
  .platform h3 {
    font-size: 1.25rem;
  }
  .platform p {
    color: var(--hp-text-muted);
  }
  .platform span {
    color: var(--hp-text-faint);
    font-size: 0.875rem;
  }

  .cta {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 2rem;
    align-items: center;
    padding: clamp(2rem, 1rem + 4vw, 4rem);
    background:
      radial-gradient(40rem 20rem at 100% 0%, var(--hp-glow), transparent 70%),
      var(--hp-surface);
  }
  @media (min-width: 64rem) {
    .cta {
      grid-template-columns: 1fr auto;
    }
  }
  .cta__text {
    display: grid;
    gap: 0.75rem;
    max-width: 36rem;
  }
  .cta h2 {
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
  }
  .cta p {
    color: var(--hp-text-muted);
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
