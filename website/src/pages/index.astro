---
import SiteLayout from '@/app/layouts/SiteLayout.astro';
import { getLatestRelease } from '@/core/release';
import { TAGLINE } from '@/core/site';
import {
  Board,
  CallToAction,
  Connections,
  Hero,
  Inside,
  Intro,
  Safeguards,
  softwareApplication,
} from '@/features/home';
import { ScrollReveal } from '@/shared/ui';

const jsonLd = softwareApplication(Astro.site, await getLatestRelease());
---

<SiteLayout title={`Homeport — ${TAGLINE}`} jsonLd={jsonLd} wide>
  <Hero />
  <Intro />
  <Connections />
  <Board />
  <Inside />
  <Safeguards />
  <CallToAction />
  <ScrollReveal />
</SiteLayout>
