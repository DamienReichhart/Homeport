---
/*
 * "Download for <your OS>". Rendered as a link to the download page; a script
 * then points it at the right installer when the visitor's system is clear.
 * Any element with `data-download-note` on the page gets a matching hint
 * (see DownloadMeta.astro).
 */
import { getLatestRelease } from '@/core/release';
import { href } from '@/shared/lib/href';
import { Icon } from '@/shared/ui';

interface Props {
  size?: 'large' | 'default';
}

const { size = 'large' } = Astro.props;
const release = await getLatestRelease();
const pick = (os: string, arch: string, format: string) =>
  release?.installers.find((i) => i.os === os && i.arch === arch && i.format === format)?.url ?? '';

const targets = {
  'windows-x64': pick('windows', 'x64', 'nsis'),
  'windows-arm64': pick('windows', 'arm64', 'nsis'),
  'macos-arm64': pick('macos', 'arm64', 'dmg'),
  'macos-x64': pick('macos', 'x64', 'dmg'),
};
const downloadPage = href('/download/');
---

<a
  class:list={['button button--primary', size === 'large' && 'button--large']}
  href={downloadPage}
  data-download-link
  data-targets={JSON.stringify(targets)}
  data-page={downloadPage}
>
  <Icon name="download" />
  <span data-download-label>Download Homeport</span>
</a>

<script>
  import { detectPlatform } from '../lib/platform';

  const NAMES = { windows: 'Windows', macos: 'macOS', linux: 'Linux' } as const;

  async function enhance() {
    const { os, arch } = await detectPlatform();
    if (os === 'other') return;

    let note: string;
    if (os === 'windows') note = arch === 'arm64' ? 'Windows on ARM installer' : 'Windows x64 installer';
    else if (os === 'macos')
      note = arch === 'arm64' ? 'For Apple silicon Macs' : arch === 'x64' ? 'For Intel Macs' : 'Apple silicon and Intel';
    else note = '.deb, .rpm and AppImage';
    document.querySelectorAll('[data-download-note]').forEach((el) => (el.textContent = note));

    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-download-link]')) {
      const targets = JSON.parse(link.dataset.targets ?? '{}') as Record<string, string>;
      const label = link.querySelector('[data-download-label]');
      if (label) label.textContent = `Download for ${NAMES[os]}`;
      // Go to the platform's section unless one file is clearly right.
      link.href = `${link.dataset.page}#${os}`;
      const direct =
        os === 'windows' ? targets[`windows-${arch ?? 'x64'}`] : os === 'macos' && arch ? targets[`macos-${arch}`] : '';
      if (direct) link.href = direct;
    }
  }

  void enhance();
</script>
