---
/** "Version 0.1.0 · Windows x64 installer · All downloads", under a DownloadButton. */
import { getLatestRelease } from '../lib/releases';
import { href } from '../lib/site';

const release = await getLatestRelease();
---

<p class="download-meta">
  {release && <>Version {release.version} · </>}
  <span data-download-note>Windows, macOS and Linux</span> ·
  <a href={href('/download/')}>All downloads</a>
</p>

<style>
  .download-meta {
    color: var(--hp-text-faint);
    font-size: 0.85rem;
  }
  .download-meta a {
    color: var(--hp-text-muted);
  }
</style>
