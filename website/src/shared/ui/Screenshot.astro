---
/*
 * A screenshot of the app, in the visitor's theme when both variants exist.
 * Shots live in src/assets/screenshots as `<name>-light.png` / `<name>-dark.png`
 * (or just `<name>.png`); regenerate them with `bun run screenshots` at the repo root.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  name: string;
  alt: string;
  /** Rendered width hints for responsive images. */
  sizes?: string;
  eager?: boolean;
  class?: string;
  /** Show only the top-left part of the shot, at this aspect ratio (e.g. `960 / 900`). */
  crop?: string;
}

const {
  name,
  alt,
  sizes = '(min-width: 72rem) 1100px, 100vw',
  eager = false,
  crop,
} = Astro.props;
const cropStyle = crop
  ? `aspect-ratio: ${crop}; object-fit: cover; object-position: left top;`
  : undefined;

const shots = import.meta.glob<{ default: ImageMetadata }>('/src/assets/screenshots/*.png', {
  eager: true,
});
const find = (file: string) => shots[`/src/assets/screenshots/${file}.png`]?.default;

// A plain `<name>.png` is the light variant when a `-dark` one exists, and vice versa.
const plain = find(name);
const dark = find(`${name}-dark`) ?? (find(`${name}-light`) ? plain : undefined);
const light = find(`${name}-light`) ?? (dark ? plain : undefined);
const variants: { image: ImageMetadata; theme: string }[] =
  light && dark
    ? [
        { image: dark, theme: 'only-dark' },
        { image: light, theme: 'only-light' },
      ]
    : [plain ?? dark ?? light].filter((i) => i !== undefined).map((image) => ({ image, theme: '' }));

if (variants.length === 0) console.warn(`[screenshot] missing src/assets/screenshots/${name}*.png`);
---

<div class:list={['window', Astro.props.class]}>
  {
    variants.map(({ image, theme }) => (
      <Picture
        src={image}
        alt={alt}
        class={theme || undefined}
        formats={['avif', 'webp']}
        widths={[640, 960, 1440, 2160].filter((w) => w <= image.width)}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding="async"
        style={cropStyle}
      />
    ))
  }
</div>
