---
/*
 * A screenshot of the app, in the visitor's theme when both variants exist.
 * Shots live in src/assets/screenshots as `<name>-light.png` / `<name>-dark.png`
 * (or just `<name>.png`); regenerate them with `bun run screenshots` at the repo root.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  name: string;
  alt: string;
  /** Rendered width hints for responsive images. */
  sizes?: string;
  eager?: boolean;
  class?: string;
  /** Show only the top-left part of the shot, at this aspect ratio (e.g. `960 / 900`). */
  crop?: string;
  /**
   * Fill the parent (a tile) instead of sitting in a window frame: the shot is
   * drawn `zoom` times the tile's width, so the interface reads near its real
   * size, and `x`/`y` (0–100) pick the point of the shot that stays in view.
   */
  tile?: { zoom?: number; x?: number; y?: number };
}

const {
  name,
  alt,
  sizes = '(min-width: 72rem) 1100px, 100vw',
  eager = false,
  crop,
  tile,
} = Astro.props;
const cropStyle = crop
  ? `aspect-ratio: ${crop}; object-fit: cover; object-position: left top;`
  : undefined;
const tileStyle = tile
  ? `--zoom: ${tile.zoom ?? 1}; --x: ${tile.x ?? 0}; --y: ${tile.y ?? 0};`
  : undefined;

const shots = import.meta.glob<{ default: ImageMetadata }>('/src/assets/screenshots/*.png', {
  eager: true,
});
const find = (file: string) => shots[`/src/assets/screenshots/${file}.png`]?.default;

// A plain `<name>.png` is the light variant when a `-dark` one exists, and vice versa.
const plain = find(name);
const dark = find(`${name}-dark`) ?? (find(`${name}-light`) ? plain : undefined);
const light = find(`${name}-light`) ?? (dark ? plain : undefined);
const variants: { image: ImageMetadata; theme: string }[] =
  light && dark
    ? [
        { image: dark, theme: 'only-dark' },
        { image: light, theme: 'only-light' },
      ]
    : [plain ?? dark ?? light]
        .filter((i) => i !== undefined)
        .map((image) => ({ image, theme: '' }));

if (variants.length === 0) console.warn(`[screenshot] missing src/assets/screenshots/${name}*.png`);
---

<div class:list={[tile ? 'shot-tile' : 'window', Astro.props.class]} style={tileStyle}>
  {variants.map(({ image, theme }) => (
    <Picture
      src={image}
      alt={alt}
      class={theme || undefined}
      formats={['avif', 'webp']}
      widths={[640, 960, 1440, 2160].filter((w) => w <= image.width)}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
      style={cropStyle}
    />
  ))}
</div>

<style is:global>
  /*
   * A shot filling a tile. The image is `--zoom` tiles wide; it is moved so the
   * point (--x %, --y %) of the shot sits at the same point of the tile, which
   * keeps that point in view at any tile size.
   */
  .shot-tile {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 100%;
    background: var(--hp-surface);
  }
  .shot-tile img {
    position: absolute;
    max-width: none;
    width: calc(var(--zoom) * 100%);
    height: auto;
    left: calc(var(--x) * 1%);
    top: calc(var(--y) * 1%);
    translate: calc(var(--x) * -1%) calc(var(--y) * -1%);
  }
</style>
