---
/*
 * A screenshot of the app, in the visitor's theme when both variants exist,
 * and in the page's language when it was captured in it. Shots live in
 * src/assets/screenshots as `<name>-light.png` / `<name>-dark.png` (or just
 * `<name>.png`), each language's in its own folder (`fr/<name>.png`); a shot a
 * language lacks falls back to English. Regenerate them with
 * `bun run screenshots [--locale <tag>]` at the repo root.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  name: string;
  alt: string;
  /** Rendered width hints for responsive images. */
  sizes?: string;
  eager?: boolean;
  class?: string;
  /** Show only the top-left part of the shot, at this aspect ratio (e.g. `960 / 900`). */
  crop?: string;
  /** The page's language folder (`fr`, `pt-br`); empty or absent for English. */
  folder?: string;
}

const {
  name,
  alt,
  sizes = '(min-width: 72rem) 1100px, 100vw',
  eager = false,
  crop,
  folder = '',
} = Astro.props;
const cropStyle = crop
  ? `aspect-ratio: ${crop}; object-fit: cover; object-position: left top;`
  : undefined;

const shots = import.meta.glob<{ default: ImageMetadata }>('/src/assets/screenshots/**/*.png', {
  eager: true,
});
const has = (dir: string) =>
  [name, `${name}-dark`, `${name}-light`].some(
    (f) => shots[`/src/assets/screenshots/${dir}${f}.png`],
  );
const dir = folder && has(`${folder}/`) ? `${folder}/` : '';
const find = (file: string) => shots[`/src/assets/screenshots/${dir}${file}.png`]?.default;

// A plain `<name>.png` is the light variant when a `-dark` one exists, and vice versa.
const plain = find(name);
const dark = find(`${name}-dark`) ?? (find(`${name}-light`) ? plain : undefined);
const light = find(`${name}-light`) ?? (dark ? plain : undefined);
const variants: { image: ImageMetadata; theme: string }[] =
  light && dark
    ? [
        { image: dark, theme: 'only-dark' },
        { image: light, theme: 'only-light' },
      ]
    : [plain ?? dark ?? light]
        .filter((i) => i !== undefined)
        .map((image) => ({ image, theme: '' }));

if (variants.length === 0) console.warn(`[screenshot] missing src/assets/screenshots/${name}*.png`);
---

<div class:list={['window', Astro.props.class]}>
  {variants.map(({ image, theme }) => (
    <Picture
      src={image}
      alt={alt}
      class={theme || undefined}
      formats={['avif', 'webp']}
      widths={[640, 960, 1440, 2160].filter((w) => w <= image.width)}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
      style={cropStyle}
    />
  ))}
</div>
