{
  "name": "homeport",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "rust:fmt": "cargo fmt --all",
    "rust:lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --workspace",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "bindings": "cd src-tauri && UPDATE_BINDINGS=1 cargo test --lib bindings_are_up_to_date",
    "licenses": "bun scripts/licenses.ts"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
