{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Homeport",
  "version": "0.12.0",
  "identifier": "com.homeport.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run licenses && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Homeport",
        "visible": false,
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Every Docker Engine, on one board.",
    "longDescription": "A desktop app for managing Docker Engines anywhere: this machine's, or remote ones over SSH, TLS or TCP.",
    "publisher": "Damien Reichhart",
    "copyright": "Copyright (c) 2026 Damien Reichhart",
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/DamienReichhart/Homeport",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "licenses/": "licenses/"
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/doc/homeport/copyright": "../LICENSE",
          "/usr/share/doc/homeport/THIRD_PARTY_LICENSES.txt": "licenses/THIRD_PARTY_LICENSES.txt",
          "/usr/share/homeport/homeport.asc": "../packaging/linux/homeport.asc",
          "/usr/share/homeport/homeport.sources": "../packaging/linux/homeport.sources"
        },
        "postInstallScript": "../packaging/linux/deb-postinst.sh",
        "postRemoveScript": "../packaging/linux/deb-postrm.sh"
      },
      "rpm": {
        "files": {
          "/usr/share/licenses/homeport/LICENSE": "../LICENSE",
          "/usr/share/licenses/homeport/THIRD_PARTY_LICENSES.txt": "licenses/THIRD_PARTY_LICENSES.txt",
          "/usr/share/homeport/homeport.asc": "../packaging/linux/homeport.asc",
          "/usr/share/homeport/homeport.repo": "../packaging/linux/homeport.repo"
        },
        "postInstallScript": "../packaging/linux/rpm-post.sh",
        "postRemoveScript": "../packaging/linux/rpm-postun.sh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1RDEzNTdGQUE1ODlFOUYKUldTZm5saXFmelhSUlliZE51NXcrVElWL1JpWGpXUkNnSnpXTk1MdzFhZE1HZHcyMkh5Vm04MDcK",
      "endpoints": ["https://damienreichhart.github.io/Homeport/updates/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
